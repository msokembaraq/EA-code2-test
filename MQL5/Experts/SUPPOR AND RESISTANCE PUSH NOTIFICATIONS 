//+------------------------------------------------------------------+
//| Touch notify cooldown (separate from signal cooldown)            |
//+------------------------------------------------------------------+
bool TouchCooldownOk(double center,double atr,int curBar)
  {
   for(int i=0;i<touchNotifyCount;i++)
      if(MathAbs(touchNotifyCenters[i]-center)<=atr*clusterTol)
         if(curBar-touchNotifyBars[i]<InpTouchCooldown) return false;
   return true;
  }

void RecordTouchNotify(double center,int curBar)
  {
   if(touchNotifyCount>=ArraySize(touchNotifyCenters))
     {ArrayResize(touchNotifyCenters,touchNotifyCount+10);ArrayResize(touchNotifyBars,touchNotifyCount+10);}
   touchNotifyCenters[touchNotifyCount]=center;
   touchNotifyBars[touchNotifyCount]=curBar;
   touchNotifyCount++;
   if(touchNotifyCount>50)
     {
      for(int i=0;i<touchNotifyCount-1;i++)
        {touchNotifyCenters[i]=touchNotifyCenters[i+1];touchNotifyBars[i]=touchNotifyBars[i+1];}
      touchNotifyCount--;
     }
  }

// Break notify dedup: one push per zone per break (cooldown = InpRetestWindow bars)
bool BreakCooldownOk(double center,double atr,int curBar)
  {
   for(int i=0;i<breakNotifyCount;i++)
      if(MathAbs(breakNotifyCenters[i]-center)<=atr*clusterTol)
         if(curBar-breakNotifyBars[i]<InpRetestWindow) return false;
   return true;
  }

void RecordBreakNotify(double center,int curBar)
  {
   if(breakNotifyCount>=ArraySize(breakNotifyCenters))
     {ArrayResize(breakNotifyCenters,breakNotifyCount+10);ArrayResize(breakNotifyBars,breakNotifyCount+10);}
   breakNotifyCenters[breakNotifyCount]=center;
   breakNotifyBars[breakNotifyCount]=curBar;
   breakNotifyCount++;
   if(breakNotifyCount>50)
     {
      for(int i=0;i<breakNotifyCount-1;i++)
        {breakNotifyCenters[i]=breakNotifyCenters[i+1];breakNotifyBars[i]=breakNotifyBars[i+1];}
      breakNotifyCount--;
     }
  }

// Retest notify cooldown: one push per zone per InpRetestWindow bars
bool RetestCooldownOk(double center,double atr,int curBar)
  {
   for(int i=0;i<retestNotifyCount;i++)
      if(MathAbs(retestNotifyCenters[i]-center)<=atr*clusterTol)
         if(curBar-retestNotifyBars[i]<InpRetestWindow) return false;
   return true;
  }

void RecordRetestNotify(double center,int curBar)
  {
   if(retestNotifyCount>=ArraySize(retestNotifyCenters))
     {ArrayResize(retestNotifyCenters,retestNotifyCount+10);ArrayResize(retestNotifyBars,retestNotifyCount+10);}
   retestNotifyCenters[retestNotifyCount]=center;
   retestNotifyBars[retestNotifyCount]=curBar;
   retestNotifyCount++;
   if(retestNotifyCount>50)
     {
      for(int i=0;i<retestNotifyCount-1;i++)
        {retestNotifyCenters[i]=retestNotifyCenters[i+1];retestNotifyBars[i]=retestNotifyBars[i+1];}
      retestNotifyCount--;
     }
  }

// Break message: fires at the moment a zone is cleanly broken
// BUY BREAK = resistance broken (bullish), SELL BREAK = support broken (bearish)
// SL sits on opposite side of the broken zone; TPs from alive zones beyond entry
string BuildBreakMsg(bool isBull,Zone &z,double entry,double atr)
  {
   double sl = isBull ? z.bot-atr*InpSLBuffer : z.top+atr*InpSLBuffer;
   double R  = MathAbs(entry-sl);
double tp[]; int tpCount=0;
   if(isBull) CollectBullTPs(entry,tp,tpCount);
   else       CollectBearTPs(entry,tp,tpCount);
   ArrayResize(tp,3);
   for(int i=tpCount;i<3;i++) tp[i]=isBull?entry+(i+1)*R:entry-(i+1)*R;
   // Sort: bull ascending (nearest above first), bear descending (nearest below first)
   for(int a=0;a<2;a++)
      for(int b=a+1;b<3;b++)
        { bool sw=isBull?(tp[b]<tp[a]):(tp[b]>tp[a]);
          if(sw){double t=tp[a];tp[a]=tp[b];tp[b]=t;} }
   string dir=isBull?"BUY BREAK":"SELL BREAK";
   return dir+" | "+_Symbol+" "+PeriodShort()+" | E:"+DoubleToString(entry,_Digits)+
          " SL:"+DoubleToString(sl,_Digits)+
          " TP1:"+DoubleToString(tp[0],_Digits)+
          " TP2:"+DoubleToString(tp[1],_Digits)+
          " TP3:"+DoubleToString(tp[2],_Digits);
  }

//+------------------------------------------------------------------+
//| Find the broken zone that triggered bull/bear retest             |
//+------------------------------------------------------------------+
bool FindRetestZoneBull(int bar,const double &open[],const double &low[],
                        const double &close[],Zone &outZ)
  {
   for(int i=0;i<brokenCount;i++)
     {
      if(!brokenZones[i].isResistance||!brokenZones[i].wasBroken||brokenZones[i].diedBar<0) continue;
      int age=bar-brokenZones[i].diedBar;
      if(age>0&&age<=InpRetestWindow&&
         low[bar]<=brokenZones[i].top&&
         close[bar]>=brokenZones[i].bot&&
         close[bar]>=open[bar])
        {outZ=brokenZones[i];return true;}
     }
   return false;
  }

bool FindRetestZoneBear(int bar,const double &open[],const double &high[],
                        const double &close[],Zone &outZ)
  {
   for(int i=0;i<brokenCount;i++)
     {
      if(brokenZones[i].isResistance||!brokenZones[i].wasBroken||brokenZones[i].diedBar<0) continue;
      int age=bar-brokenZones[i].diedBar;
      if(age>0&&age<=InpRetestWindow&&
         high[bar]>=brokenZones[i].bot&&
         close[bar]<=brokenZones[i].top&&
         close[bar]<=open[bar])
        {outZ=brokenZones[i];return true;}
     }
   return false;
  }

//+------------------------------------------------------------------+
//| Collect TP levels from alive zones                               |
//| Bull: nearest alive resistance zones ABOVE entry (ascending)     |
//| Bear: nearest alive support zones BELOW entry (descending)       |
//+------------------------------------------------------------------+
void CollectBullTPs(double entry,double &tp[],int &tpCount)
  {
   tpCount=0;
   double cands[]; int cc=0; ArrayResize(cands,resCount);
   for(int i=0;i<resCount;i++)
      if(resZones[i].diedBar<0&&resZones[i].center>entry)
         cands[cc++]=resZones[i].center;
   // sort ascending
   for(int i=0;i<cc-1;i++)
      for(int j=i+1;j<cc;j++)
         if(cands[j]<cands[i]){double t=cands[i];cands[i]=cands[j];cands[j]=t;}
   tpCount=MathMin(cc,3);
   ArrayResize(tp,3);
   for(int i=0;i<tpCount;i++) tp[i]=cands[i];
  }

void CollectBearTPs(double entry,double &tp[],int &tpCount)
  {
   tpCount=0;
   double cands[]; int cc=0; ArrayResize(cands,supCount);
   for(int i=0;i<supCount;i++)
      if(supZones[i].diedBar<0&&supZones[i].center<entry)
         cands[cc++]=supZones[i].center;
   // sort descending (nearest below first)
   for(int i=0;i<cc-1;i++)
      for(int j=i+1;j<cc;j++)
         if(cands[j]>cands[i]){double t=cands[i];cands[i]=cands[j];cands[j]=t;}
   tpCount=MathMin(cc,3);
   ArrayResize(tp,3);
   for(int i=0;i<tpCount;i++) tp[i]=cands[i];
  }

//+------------------------------------------------------------------+
//| Build retest push message                                        |
//+------------------------------------------------------------------+
string BuildRetestMsg(bool isBull,Zone &z,double entry,double atr)
  {
   double sl  = isBull ? z.bot - atr*InpSLBuffer : z.top + atr*InpSLBuffer;
   double R   = MathAbs(entry-sl);
   double tp[];int tpCount=0;
   if(isBull) CollectBullTPs(entry,tp,tpCount);
   else       CollectBearTPs(entry,tp,tpCount);
// Fill missing TPs with R-multiples
   ArrayResize(tp,3);
   for(int i=tpCount;i<3;i++)
      tp[i]=isBull ? entry+(i+1)*R : entry-(i+1)*R;
   // Sort: bull ascending (nearest above first), bear descending (nearest below first)
   for(int a=0;a<2;a++)
      for(int b=a+1;b<3;b++)
        { bool sw=isBull?(tp[b]<tp[a]):(tp[b]>tp[a]);
          if(sw){double t=tp[a];tp[a]=tp[b];tp[b]=t;} }
   string dir=isBull?"BUY RETEST":"SELL RETEST";
   string sym=_Symbol+" "+PeriodShort();
   return dir+" | "+sym+" | E:"+DoubleToString(entry,_Digits)+
          " SL:"+DoubleToString(sl,_Digits)+
          " TP1:"+DoubleToString(tp[0],_Digits)+
          " TP2:"+DoubleToString(tp[1],_Digits)+
          " TP3:"+DoubleToString(tp[2],_Digits);
  }

//+------------------------------------------------------------------+
//| Guard: true if price is inside or within 1 ATR of any alive zone |
//| Used to suppress retest signals blocked by an unbroken zone      |
//+------------------------------------------------------------------+
bool IsBlockedByAliveZone(double price,double atr)
  {
   double buf=atr*1.0; // 1 ATR proximity buffer — tighten/loosen as needed
   for(int i=0;i<resCount;i++)
      if(resZones[i].diedBar<0&&
         price>=resZones[i].bot-buf&&price<=resZones[i].top+buf)
         return true;
   for(int i=0;i<supCount;i++)
      if(supZones[i].diedBar<0&&
         price>=supZones[i].bot-buf&&price<=supZones[i].top+buf)
         return true;
   return false;
  }

//+------------------------------------------------------------------+
//| Zone touch push: scan all alive zones, fire on strongest touch   |
//+------------------------------------------------------------------+
// ZoneTouchPush fires only on a REACTION touch — price enters zone and
// closes back with a directional close (mirrors CheckSupBounce / CheckResReject).
// Bare pass-through candles (no close-back) are ignored.
void ZoneTouchPush(int bar,const double &open[],const double &high[],
                   const double &low[],const double &close[],double atr)
  {
   Zone  bestZone={}; bool found=false; double bestStr=0;

   // Resistance reaction: high pierces zone from below, close holds inside or below, bearish close
   for(int i=0;i<resCount;i++)
     {
      if(!ZoneRenderable(resZones[i])) continue;
      bool pierced  = high[bar]>=resZones[i].bot;
      bool heldDown = close[bar]<=resZones[i].top&&close[bar]<=open[bar];
      if(pierced&&heldDown&&
         TouchCooldownOk(resZones[i].center,atr,bar)&&
         resZones[i].strength>bestStr)
        {bestStr=resZones[i].strength;bestZone=resZones[i];found=true;}
     }

   // Support reaction: low pierces zone from above, close holds inside or above, bullish close
   for(int i=0;i<supCount;i++)
     {
      if(!ZoneRenderable(supZones[i])) continue;
      bool pierced = low[bar]<=supZones[i].top;
      bool heldUp  = close[bar]>=supZones[i].bot&&close[bar]>=open[bar];
      if(pierced&&heldUp&&
         TouchCooldownOk(supZones[i].center,atr,bar)&&
         supZones[i].strength>bestStr)
        {bestStr=supZones[i].strength;bestZone=supZones[i];found=true;}
     }

   if(!found) return;
string dir = bestZone.isResistance ? "SELL ZONE READY" : "BUY ZONE READY";
   string msg = dir+" | "+_Symbol+" "+PeriodShort()+" | "+DoubleToString(bestZone.center,_Digits);
   PushOrPrint(msg);
   if(InpWriteGV)
     {
      GlobalVariableSet("SRZONES_DIR",   bestZone.isResistance ? -1.0 : 1.0);
      GlobalVariableSet("SRZONES_PRICE", bestZone.center);
      GlobalVariableSet("SRZONES_TIME",  (double)TimeCurrent());
     }
   RecordTouchNotify(bestZone.center,bar);
  }

//+------------------------------------------------------------------+
//| OnInit                                                            |
//+------------------------------------------------------------------+
int OnInit()
  {
   switch(InpPreset)
     {
      case SCALP:  pivLeft=4;  pivRight=2;  clusterTol=0.4; minSpacing=4;  break;
      case LOCAL:  pivLeft=6;  pivRight=4;  clusterTol=0.5; minSpacing=8;  break;
      case SWING:  pivLeft=15; pivRight=8;  clusterTol=0.9; minSpacing=20; break;
      case MAJOR:  pivLeft=35; pivRight=15; clusterTol=1.4; minSpacing=50; break;
      case CUSTOM: pivLeft=InpPivLeft; pivRight=InpPivRight;
                   clusterTol=InpClusterTol; minSpacing=InpMinSpacing; break;
     }
   ArrayResize(highPivots,InpPivBuffer+10); ArrayResize(lowPivots,InpPivBuffer+10);
   highPivotCount=0; lowPivotCount=0;
   ArrayResize(resZones,InpZoneCount+10); ArrayResize(supZones,InpZoneCount+10);
   ArrayResize(brokenZones,100);
   resCount=0; supCount=0; brokenCount=0;
   ArrayResize(sigZoneCenters,50); ArrayResize(sigZoneBars,50); sigCount=0;
   ArrayResize(touchNotifyCenters,50); ArrayResize(touchNotifyBars,50); touchNotifyCount=0;
   ArrayResize(retestNotifyCenters,50); ArrayResize(retestNotifyBars,50); retestNotifyCount=0;
   ArrayResize(breakNotifyCenters,50);  ArrayResize(breakNotifyBars,50);  breakNotifyCount=0;
   atrHandle=iATR(_Symbol,_Period,50);
   if(atrHandle==INVALID_HANDLE){Print("Failed to create ATR handle");return INIT_FAILED;}
   IndicatorSetInteger(INDICATOR_DIGITS,_Digits);
   IndicatorSetString(INDICATOR_SHORTNAME,"S&R Zones [B1dii]");
   return INIT_SUCCEEDED;
  }

void OnDeinit(const int reason)
  {ClearDrawings();IndicatorRelease(atrHandle);}

//+------------------------------------------------------------------+
//| OnCalculate                                                       |
//+------------------------------------------------------------------+
int OnCalculate(const int rates_total,const int prev_calculated,
                const datetime &time[],const double &open[],
                const double &high[],const double &low[],const double &close[],
                const long &tick_volume[],const long &volume[],const int &spread[])
  {
   if(rates_total<pivLeft+pivRight+50) return 0;
   double atrArr[]; ArrayResize(atrArr,rates_total);
   if(CopyBuffer(atrHandle,0,0,rates_total,atrArr)<=0) return prev_calculated;
   double volMaArr[]; RollingVolumeSMA(tick_volume,rates_total,50,volMaArr);
   int start=prev_calculated>0?MathMax(pivLeft+pivRight,prev_calculated-1):pivLeft+pivRight;

   for(int bar=start;bar<rates_total;bar++)
     {
      double atr=atrArr[bar],volMa=volMaArr[bar];
      if(atr<=0||volMa<=0) continue;
      int cb=bar-pivRight;
      if(cb<pivLeft) continue;
      bool nhp=false,nlp=false;
      if(!IsDuplicatePivot(highPivots,highPivotCount,cb)&&IsPivotHigh(cb,high,rates_total))
        {
         Pivot p; p.price=high[cb]; p.bar=cb; p.vol=SafeVolume(tick_volume[cb]);
         p.wick=UpperWick(high[cb],open[cb],close[cb]);
         AddPivot(highPivots,highPivotCount,p,InpPivBuffer); nhp=true;
        }
      if(!IsDuplicatePivot(lowPivots,lowPivotCount,cb)&&IsPivotLow(cb,low,rates_total))
        {
         Pivot p; p.price=low[cb]; p.bar=cb; p.vol=SafeVolume(tick_volume[cb]);
         p.wick=LowerWick(low[cb],open[cb],close[cb]);
         AddPivot(lowPivots,lowPivotCount,p,InpPivBuffer); nlp=true;
        }

      for(int i=0;i<resCount;i++)
         if(resZones[i].diedBar<0&&close[bar]>resZones[i].top)
           {resZones[i].diedBar=bar;resZones[i].wasBroken=true;
            resZones[i].isLiveBreak=(close[bar-1]<=resZones[i].top);ArchiveZone(resZones[i],atr);}
      for(int i=0;i<supCount;i++)
         if(supZones[i].diedBar<0&&close[bar]<supZones[i].bot)
           {supZones[i].diedBar=bar;supZones[i].wasBroken=true;
            supZones[i].isLiveBreak=(close[bar-1]>=supZones[i].bot);ArchiveZone(supZones[i],atr);}

      for(int i=0;i<resCount;i++)
         if(resZones[i].diedBar<0&&high[bar]>=resZones[i].bot&&low[bar]<=resZones[i].top)
            resZones[i].lastTouch=bar;
      for(int i=0;i<supCount;i++)
         if(supZones[i].diedBar<0&&high[bar]>=supZones[i].bot&&low[bar]<=supZones[i].top)
            supZones[i].lastTouch=bar;

      if(nhp||nlp)
        {
         Zone nr[],ns[]; int nrc=0,nsc=0;
         BuildZones(highPivots,highPivotCount,true,atr,volMa,bar,nr,nrc);
         BuildZones(lowPivots,lowPivotCount,false,atr,volMa,bar,ns,nsc);
         Zone or2[],os[]; int orc=resCount,osc=supCount;
         ArrayResize(or2,resCount); ArrayResize(os,supCount);
         for(int i=0;i<resCount;i++) or2[i]=resZones[i];
         for(int i=0;i<supCount;i++) os[i]=supZones[i];
         for(int i=0;i<orc;i++)
            if(or2[i].diedBar<0&&or2[i].touches>=InpMinTouches&&!ZoneSurvives(or2[i],nr,nrc,atr))
              {or2[i].diedBar=bar;or2[i].wasBroken=false;ArchiveZone(or2[i],atr);}
         for(int i=0;i<osc;i++)
            if(os[i].diedBar<0&&os[i].touches>=InpMinTouches&&!ZoneSurvives(os[i],ns,nsc,atr))
              {os[i].diedBar=bar;os[i].wasBroken=false;ArchiveZone(os[i],atr);}
         resCount=0; ArrayResize(resZones,InpZoneCount);
         for(int i=0;i<nrc;i++)
            if(!IsAlreadyBroken(nr[i],atr))
              {InheritState(nr[i],or2,orc,atr);
               if(resCount>=ArraySize(resZones)) ArrayResize(resZones,resCount+10);
               resZones[resCount++]=nr[i];}
         supCount=0; ArrayResize(supZones,InpZoneCount);
         for(int i=0;i<nsc;i++)
            if(!IsAlreadyBroken(ns[i],atr))
              {InheritState(ns[i],os,osc,atr);
               if(supCount>=ArraySize(supZones)) ArrayResize(supZones,supCount+10);
               supZones[supCount++]=ns[i];}
        }

      if(bar==rates_total-1)
        {
         bool bounceUp  =CheckSupBounce(bar,open,high,low,close,atr);
         bool bounceDown=CheckResReject(bar,open,high,low,close,atr);
         bool retestUp  =CheckRetestBull(bar,open,high,low,close);
         bool retestDown=CheckRetestBear(bar,open,high,low,close);

         if(InpShowTest&&bounceUp)
           {string n=prefix+"ARROW_UP_"+IntegerToString(bar);
            ObjectCreate(0,n,OBJ_ARROW_THUMB_UP,0,time[bar],low[bar]-5*_Point);
            ObjectSetInteger(0,n,OBJPROP_COLOR,InpSupColor);ObjectSetInteger(0,n,OBJPROP_WIDTH,1);}
         if(InpShowTest&&bounceDown)
           {string n=prefix+"ARROW_DN_"+IntegerToString(bar);
            ObjectCreate(0,n,OBJ_ARROW_THUMB_DOWN,0,time[bar],high[bar]+5*_Point);
            ObjectSetInteger(0,n,OBJPROP_COLOR,InpResColor);ObjectSetInteger(0,n,OBJPROP_WIDTH,1);}
         if(InpShowRetest&&retestUp)
           {string n=prefix+"RETEST_UP_"+IntegerToString(bar);
            ObjectCreate(0,n,OBJ_ARROW_UP,0,time[bar],low[bar]-10*_Point);
            ObjectSetInteger(0,n,OBJPROP_COLOR,InpSupColor);ObjectSetInteger(0,n,OBJPROP_WIDTH,2);}
         if(InpShowRetest&&retestDown)
           {string n=prefix+"RETEST_DN_"+IntegerToString(bar);
            ObjectCreate(0,n,OBJ_ARROW_DOWN,0,time[bar],high[bar]+10*_Point);
            ObjectSetInteger(0,n,OBJPROP_COLOR,InpResColor);ObjectSetInteger(0,n,OBJPROP_WIDTH,2);}

         // --- Push notifications ---
         if(InpPushZoneTouch)
            ZoneTouchPush(bar,open,high,low,close,atr);

         // Break push: fires once per zone on the bar it is cleanly broken
if(InpPushBreak)
            for(int i=0;i<brokenCount;i++)
               if(brokenZones[i].diedBar==bar-1&&brokenZones[i].wasBroken&&brokenZones[i].isLiveBreak)
                  if(BreakCooldownOk(brokenZones[i].center,atr,bar))
                    {
                     bool isBull=brokenZones[i].isResistance;
string msg=BuildBreakMsg(isBull,brokenZones[i],close[bar],atr);
                     PushOrPrint(msg);
                     if(InpWriteGV)
                       {
                        GlobalVariableSet("SRZONES_DIR",   isBull ? 1.0 : -1.0);
                        GlobalVariableSet("SRZONES_PRICE", brokenZones[i].center);
                        GlobalVariableSet("SRZONES_TIME",  (double)TimeCurrent());
                       }
                     RecordBreakNotify(brokenZones[i].center,bar);
                    }

if(InpPushRetest&&!IsBlockedByAliveZone(close[bar-1],atr))
           {
            if(retestUp)
              {
               Zone rz; bool found=FindRetestZoneBull(bar,open,low,close,rz);
               Zone dummy; if(!found){dummy.bot=close[bar-1]-atr;dummy.top=close[bar-1];rz=dummy;}
if(RetestCooldownOk(rz.center,atr,bar))
                 {
                  string msg=BuildRetestMsg(true,rz,close[bar-1],atr);
                  PushOrPrint(msg);
                  if(InpWriteGV)
                    {
                     GlobalVariableSet("SRZONES_DIR",   1.0);
                     GlobalVariableSet("SRZONES_PRICE", rz.center);
                     GlobalVariableSet("SRZONES_TIME",  (double)TimeCurrent());
                    }
                  RecordRetestNotify(rz.center,bar);
                 }
              }
            if(retestDown)
              {
               Zone rz; bool found=FindRetestZoneBear(bar,open,high,close,rz);
               Zone dummy; if(!found){dummy.top=close[bar-1]+atr;dummy.bot=close[bar-1];rz=dummy;}
               if(RetestCooldownOk(rz.center,atr,bar))
                 {
                  string msg=BuildRetestMsg(false,rz,close[bar-1],atr);
                  PushOrPrint(msg);
                  if(InpWriteGV)
                    {
                     GlobalVariableSet("SRZONES_DIR",   -1.0);
                     GlobalVariableSet("SRZONES_PRICE", rz.center);
                     GlobalVariableSet("SRZONES_TIME",  (double)TimeCurrent());
                    }
                  RecordRetestNotify(rz.center,bar);
                 }
              }
           }

         if(InpShowReaction)
           {
            for(int i=0;i<supCount;i++)
               if(ZoneRenderable(supZones[i])&&low[bar]<=supZones[i].top&&close[bar]>supZones[i].bot)
                 {string n=prefix+"HOLD_UP_"+IntegerToString(bar)+"_"+IntegerToString(i);
                  ObjectCreate(0,n,OBJ_ARROW_UP,0,time[bar],low[bar]-15*_Point);
                  ObjectSetInteger(0,n,OBJPROP_COLOR,InpSupColor);ObjectSetInteger(0,n,OBJPROP_WIDTH,2);}
            for(int i=0;i<resCount;i++)
               if(ZoneRenderable(resZones[i])&&high[bar]>=resZones[i].bot&&close[bar]<resZones[i].top)
                 {string n=prefix+"HOLD_DN_"+IntegerToString(bar)+"_"+IntegerToString(i);
                  ObjectCreate(0,n,OBJ_ARROW_DOWN,0,time[bar],high[bar]+15*_Point);
                  ObjectSetInteger(0,n,OBJPROP_COLOR,InpResColor);ObjectSetInteger(0,n,OBJPROP_WIDTH,2);}
           }

         ClearDrawings();
         double mxS=MaxStrengthAcross(),mxV=MaxVolAcross(),cc=close[bar];
         for(int i=0;i<resCount;i++) if(resZones[i].diedBar<0) DrawAlive(resZones[i],InpResColor,mxS,mxV,bar,rates_total,time,cc);
         for(int i=0;i<supCount;i++) if(supZones[i].diedBar<0) DrawAlive(supZones[i],InpSupColor,mxS,mxV,bar,rates_total,time,cc);
         if(InpShowBroken||InpShowDropped)
            for(int i=0;i<brokenCount;i++)
              {bool show=(brokenZones[i].wasBroken&&InpShowBroken)||(!brokenZones[i].wasBroken&&InpShowDropped);
               if(show) DrawBroken(brokenZones[i],rates_total,time,cc);}
        }
     }
   return rates_total;
  }
