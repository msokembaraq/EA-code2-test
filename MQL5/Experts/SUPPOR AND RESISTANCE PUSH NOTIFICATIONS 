double SafeVolume(long vol)        { return (vol <= 0) ? 1.0 : (double)vol; }
double UpperWick(double h,double o,double c) { return h - MathMax(o,c); }
double LowerWick(double l,double o,double c) { return MathMin(o,c) - l; }

//+------------------------------------------------------------------+
bool IsPivotHigh(int b,const double &high[],int total)
  {
   if(b<pivLeft||b+pivRight>=total) return false;
   double h=high[b]; if(h<=0) return false;
   for(int i=1;i<=pivLeft;i++)  if(high[b-i]>=h) return false;
   for(int i=1;i<=pivRight;i++) if(high[b+i]>h)  return false;
   return true;
  }

bool IsPivotLow(int b,const double &low[],int total)
  {
   if(b<pivLeft||b+pivRight>=total) return false;
   double l=low[b]; if(l<=0) return false;
   for(int i=1;i<=pivLeft;i++)  if(low[b-i]<=l) return false;
   for(int i=1;i<=pivRight;i++) if(low[b+i]<l)  return false;
   return true;
  }

bool IsDuplicatePivot(const Pivot &arr[],int count,int bar)
  {
   for(int i=count-1;i>=0&&i>=count-10;i--)
      if(arr[i].bar==bar) return true;
   return false;
  }

void AddPivot(Pivot &arr[],int &count,const Pivot &p,int maxCount)
  {
   if(count<maxCount)
     { if(count>=ArraySize(arr)) ArrayResize(arr,count+10); arr[count++]=p; }
   else
     { for(int i=0;i<count-1;i++) arr[i]=arr[i+1]; arr[count-1]=p; }
  }

void RollingVolumeSMA(const long &tv[],int total,int period,double &out[])
  {
   ArrayResize(out,total); ArrayInitialize(out,0);
   if(total<period) return;
   double sum=0;
   for(int i=0;i<period;i++) sum+=(double)tv[i];
   out[period-1]=sum/period;
   for(int i=period;i<total;i++) { sum+=(double)tv[i]-(double)tv[i-period]; out[i]=sum/period; }
   double fv=out[period-1];
   for(int i=0;i<period-1;i++) out[i]=fv;
  }

double PivotWeight(Pivot &p,double atr,double vAvg,int currentBar)
  {
   double sv=(p.vol<=0)?0.0:p.vol;
   double sw=(p.wick<0)?0.0:p.wick;
   int age=MathMax(1,currentBar-p.bar);
   double decay=1.0/(1.0+age/200.0);
   double vn=(vAvg>0)?sv/vAvg:1.0;
   double wn=(atr>0)?sw/atr:0.0;
   return (1.0+vn*0.5+wn*0.5)*decay;
  }

void BuildZones(Pivot &src[],int srcCount,bool isRes,double atr,
                double vAvg,int curBar,Zone &out[],int &outCount)
  {
   outCount=0; ArrayResize(out,0);
   if(srcCount<InpMinTouches||atr<=0) return;
   bool used[]; ArrayResize(used,srcCount); ArrayInitialize(used,false);
   double tol=atr*clusterTol;
   Zone tmp[]; int tc=0; ArrayResize(tmp,srcCount);
   for(int i=0;i<srcCount;i++)
     {
      if(used[i]) continue;
      Pivot seed=src[i];
      int mi[]; int mc=0; ArrayResize(mi,srcCount); mi[mc++]=i; used[i]=true;
      for(int j=i+1;j<srcCount;j++)
        {
         if(used[j]) continue;
         if(MathAbs(src[j].price-seed.price)<=tol)
           {
            bool fe=true;
            if(minSpacing>0)
               for(int k=0;k<mc&&fe;k++)
                  if(MathAbs(src[j].bar-src[mi[k]].bar)<minSpacing) fe=false;
            if(fe){mi[mc++]=j;used[j]=true;}
           }
        }
      if(mc>=InpMinTouches)
        {
         double ps=0,ws=0,vs=0;
         int earliest=src[mi[0]].bar,latest=src[mi[0]].bar;
         for(int k=0;k<mc;k++)
           {
            Pivot m=src[mi[k]];
            double w=PivotWeight(m,atr,vAvg,curBar);
            ps+=m.price*w; ws+=w; vs+=(m.vol>0)?m.vol:0;
            earliest=MathMin(earliest,m.bar); latest=MathMax(latest,m.bar);
           }
         if(ws>0)
           {
            double ctr=ps/ws, pad=atr*0.25;
            tmp[tc].top=ctr+pad; tmp[tc].bot=ctr-pad; tmp[tc].center=ctr;
            tmp[tc].strength=ws; tmp[tc].volSum=vs; tmp[tc].touches=mc;
            tmp[tc].firstBar=earliest; tmp[tc].lastTouch=latest;
            tmp[tc].diedBar=-1; tmp[tc].isResistance=isRes;
            tmp[tc].wasBroken=false; tmp[tc].isLiveBreak=false; tc++;
           }
        }
     }
   if(tc>0)
     {
      int keep=MathMin(InpZoneCount,tc);
      for(int i=0;i<keep&&i<tc;i++)
        {
         int bi=i;
         for(int j=i+1;j<tc;j++) if(tmp[j].strength>tmp[bi].strength) bi=j;
         if(bi!=i){Zone t=tmp[i];tmp[i]=tmp[bi];tmp[bi]=t;}
        }
      outCount=keep; ArrayResize(out,keep);
      for(int i=0;i<keep;i++) out[i]=tmp[i];
     }
  }

bool ZoneSurvives(Zone &old,Zone &nz[],int nc,double atr)
  {
   double tol=atr*clusterTol;
   for(int i=0;i<nc;i++) if(MathAbs(nz[i].center-old.center)<=tol) return true;
   return false;
  }

bool IsAlreadyBroken(Zone &z,double atr)
  {
   double tol=atr*clusterTol*0.7;
   for(int i=0;i<brokenCount;i++)
      if(brokenZones[i].isResistance==z.isResistance&&brokenZones[i].wasBroken&&
         MathAbs(brokenZones[i].center-z.center)<=tol) return true;
   return false;
  }

void ArchiveZone(Zone &z,double atr)
  {
   double tol=atr*clusterTol*0.7;
   for(int i=0;i<brokenCount;i++)
     {
      if(brokenZones[i].isResistance==z.isResistance&&MathAbs(brokenZones[i].center-z.center)<=tol)
        {
         if(z.wasBroken&&!brokenZones[i].wasBroken)
           {brokenZones[i].wasBroken=true;brokenZones[i].diedBar=z.diedBar;brokenZones[i].isLiveBreak=z.isLiveBreak;}
         return;
        }
     }
   if(brokenCount>=ArraySize(brokenZones)) ArrayResize(brokenZones,brokenCount+10);
   brokenZones[brokenCount++]=z;
   if(brokenCount>100){for(int i=0;i<brokenCount-1;i++) brokenZones[i]=brokenZones[i+1]; brokenCount--;}
  }

void InheritState(Zone &nz,Zone &old[],int oc,double atr)
  {
   double tol=atr*clusterTol;
   for(int i=0;i<oc;i++) if(MathAbs(old[i].center-nz.center)<=tol){nz.lastTouch=old[i].lastTouch;break;}
  }

bool CooldownOk(double center,double atr,int curBar)
  {
   for(int i=0;i<sigCount;i++)
      if(MathAbs(sigZoneCenters[i]-center)<=atr*clusterTol)
         if(curBar-sigZoneBars[i]<InpSigCooldown) return false;
   return true;
  }

void RecordSignal(double center,int curBar)
  {
   if(sigCount>=ArraySize(sigZoneCenters)){ArrayResize(sigZoneCenters,sigCount+10);ArrayResize(sigZoneBars,sigCount+10);}
   sigZoneCenters[sigCount]=center; sigZoneBars[sigCount]=curBar; sigCount++;
   if(sigCount>50){for(int i=0;i<sigCount-1;i++){sigZoneCenters[i]=sigZoneCenters[i+1];sigZoneBars[i]=sigZoneBars[i+1];}sigCount--;}
  }

bool ZoneRenderable(Zone &z)
  { return(z.diedBar<0&&z.touches>=InpMinTouches&&z.top>0&&z.bot>0&&z.bot<z.top); }

bool CheckSupBounce(int bar,const double &open[],const double &high[],const double &low[],const double &close[],double atr)
  {
   for(int i=0;i<supCount;i++)
     {
      if(!ZoneRenderable(supZones[i])) continue;
      if(low[bar]<=supZones[i].top&&close[bar]>=supZones[i].bot&&close[bar]>=open[bar]&&CooldownOk(supZones[i].center,atr,bar))
        {RecordSignal(supZones[i].center,bar);return true;}
     }
   return false;
  }

bool CheckResReject(int bar,const double &open[],const double &high[],const double &low[],const double &close[],double atr)
  {
   for(int i=0;i<resCount;i++)
     {
      if(!ZoneRenderable(resZones[i])) continue;
      if(high[bar]>=resZones[i].bot&&close[bar]<=resZones[i].top&&close[bar]<=open[bar]&&CooldownOk(resZones[i].center,atr,bar))
        {RecordSignal(resZones[i].center,bar);return true;}
     }
   return false;
  }

bool CheckRetestBull(int bar,const double &open[],const double &high[],const double &low[],const double &close[])
  {
   for(int i=0;i<brokenCount;i++)
     {
      if(!brokenZones[i].isResistance||!brokenZones[i].wasBroken||brokenZones[i].diedBar<0) continue;
      int age=bar-brokenZones[i].diedBar;
      if(age>0&&age<=InpRetestWindow&&low[bar]<=brokenZones[i].top&&close[bar]>=brokenZones[i].bot&&close[bar]>=open[bar])
         return true;
     }
   return false;
  }

bool CheckRetestBear(int bar,const double &open[],const double &high[],const double &low[],const double &close[])
  {
   for(int i=0;i<brokenCount;i++)
     {
      if(brokenZones[i].isResistance||!brokenZones[i].wasBroken||brokenZones[i].diedBar<0) continue;
      int age=bar-brokenZones[i].diedBar;
      if(age>0&&age<=InpRetestWindow&&high[bar]>=brokenZones[i].bot&&close[bar]<=brokenZones[i].top&&close[bar]<=open[bar])
         return true;
     }
   return false;
  }

string StrengthStars(double s,double maxS)
  {double r=(maxS>0)?s/maxS:0.0;return r>=0.85?"★★★":r>=0.55?"★★":"★";}

int AgeFade(int lastTouch,int curBar)
  {
   if(InpFadeAge<=0) return 0;
   int age=curBar-lastTouch;
   return age<=0?0:MathMin(15,(int)(age*15.0/InpFadeAge));
  }

bool IsFar(double zc,double cc)
  {return(InpHideFar>0&&cc>0&&MathAbs(zc-cc)/cc*100.0>InpHideFar);}

string FormatVolume(double v)
  {
   if(v>=1e9) return DoubleToString(v/1e9,2)+"B";
   if(v>=1e6) return DoubleToString(v/1e6,2)+"M";
   if(v>=1e3) return DoubleToString(v/1e3,2)+"K";
   return DoubleToString(v,2);
  }

int SafeStartIdx(int b,int total)
  {int ms=MathMax(0,total-4900);return(b<ms)?ms:b;}

//+------------------------------------------------------------------+
void DrawAlive(Zone &z,color bc,double mxS,double mxV,int curBar,int total,const datetime &time[],double cc)
  {
   if(z.top<=0||z.bot<=0||z.center<=0||z.bot>=z.top||IsFar(z.center,cc)) return;
   datetime rt=time[curBar]+25*PeriodSeconds(_Period);
   int si=SafeStartIdx(z.firstBar,total);
   datetime st=time[si];
   int extra=AgeFade(z.lastTouch,curBar),vb=0;
   if(InpUseVolColor&&mxV>0){double vr=MathMin(1.0,z.volSum/mxV);vb=(int)(vr*35);}
   int fo=MathMax(40,MathMin(100,InpZoneOpacity+extra-vb));
   int eo=MathMin(100,35+extra-vb/2);
   string uid=IntegerToString(curBar)+"_"+IntegerToString(MathRand());
   string bn=prefix+"B_"+(z.isResistance?"R_":"S_")+uid;
   ObjectCreate(0,bn,OBJ_RECTANGLE,0,st,z.top,rt,z.bot);
   ObjectSetInteger(0,bn,OBJPROP_COLOR,clrNONE);
   ObjectSetInteger(0,bn,OBJPROP_BGCOLOR,ColorToARGB(bc,(uchar)MathRound(fo*2.55)));
   ObjectSetInteger(0,bn,OBJPROP_FILL,true); ObjectSetInteger(0,bn,OBJPROP_BACK,true);
   ObjectSetInteger(0,bn,OBJPROP_SELECTABLE,false); ObjectSetInteger(0,bn,OBJPROP_HIDDEN,true);
   string ln=prefix+"L_"+(z.isResistance?"R_":"S_")+uid;
   ObjectCreate(0,ln,OBJ_TREND,0,st,z.center,rt,z.center);
   ObjectSetInteger(0,ln,OBJPROP_COLOR,ColorToARGB(bc,(uchar)MathRound(eo*2.55)));
   ObjectSetInteger(0,ln,OBJPROP_STYLE,STYLE_DASH); ObjectSetInteger(0,ln,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,ln,OBJPROP_BACK,true); ObjectSetInteger(0,ln,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,ln,OBJPROP_HIDDEN,true);
   if(InpShowLabels)
     {
      string lbn=prefix+"LB_"+(z.isResistance?"R_":"S_")+uid;
      string txt="",stars=StrengthStars(z.strength,mxS);
      if(InpShowVolText&&mxV>0)
        {
         string vv=(InpVolFormat==PERCENTAGE)?IntegerToString((int)((z.volSum/mxV)*100))+"%":FormatVolume(z.volSum);
         txt=InpSingleLine?stars+"  "+IntegerToString(z.touches)+"x  -  Vol: "+vv:"Vol: "+vv+"\n"+stars+"  "+IntegerToString(z.touches)+"x";
        }
      else txt=stars+"  "+IntegerToString(z.touches)+"x";
      ObjectCreate(0,lbn,OBJ_TEXT,0,rt,z.center);
      ObjectSetString(0,lbn,OBJPROP_TEXT,txt);
      ObjectSetInteger(0,lbn,OBJPROP_COLOR,ChartGetInteger(0,CHART_COLOR_FOREGROUND));
      ObjectSetInteger(0,lbn,OBJPROP_FONTSIZE,8); ObjectSetInteger(0,lbn,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,lbn,OBJPROP_HIDDEN,true); ObjectSetInteger(0,lbn,OBJPROP_BACK,false);
     }
  }

void DrawBroken(Zone &z,int total,const datetime &time[],double cc)
  {
   if(z.top<=0||z.bot<=0||z.bot>=z.top||IsFar(z.center,cc)) return;
   color uc=z.isResistance?InpBrokenBear:InpBrokenBull;
   int si=SafeStartIdx(z.firstBar,total);
   int ei=(z.diedBar<0)?0:SafeStartIdx(z.diedBar,total);
   string uid=IntegerToString(MathRand());
   string bn=prefix+"BROKEN_B_"+uid;
   ObjectCreate(0,bn,OBJ_RECTANGLE,0,time[si],z.top,time[ei],z.bot);
   ObjectSetInteger(0,bn,OBJPROP_COLOR,clrNONE);
   ObjectSetInteger(0,bn,OBJPROP_BGCOLOR,ColorToARGB(uc,(uchar)MathRound(InpBrokenOp*2.55)));
   ObjectSetInteger(0,bn,OBJPROP_FILL,true); ObjectSetInteger(0,bn,OBJPROP_BACK,true);
   ObjectSetInteger(0,bn,OBJPROP_SELECTABLE,false); ObjectSetInteger(0,bn,OBJPROP_HIDDEN,true);
   string ln=prefix+"BROKEN_L_"+uid;
   ObjectCreate(0,ln,OBJ_TREND,0,time[si],z.center,time[ei],z.center);
   ObjectSetInteger(0,ln,OBJPROP_COLOR,ColorToARGB(uc,(uchar)MathRound(MathMin(100,InpBrokenOp+10)*2.55)));
   ObjectSetInteger(0,ln,OBJPROP_STYLE,STYLE_DASH); ObjectSetInteger(0,ln,OBJPROP_WIDTH,1);
   ObjectSetInteger(0,ln,OBJPROP_BACK,true); ObjectSetInteger(0,ln,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,ln,OBJPROP_HIDDEN,true);
   if(InpShowReaction&&z.wasBroken&&z.diedBar>=0&&z.isLiveBreak)
     {
      string lbn=prefix+"BREAK_LB_"+uid;
      double ly=z.isResistance?z.top:z.bot;
      string tx=z.isResistance?"Break R":"Break S";
      color lc=z.isResistance?clrOrangeRed:clrMediumSeaGreen;
      ObjectCreate(0,lbn,OBJ_TEXT,0,time[ei],ly);
      ObjectSetString(0,lbn,OBJPROP_TEXT,tx);
      ObjectSetInteger(0,lbn,OBJPROP_COLOR,lc);
      ObjectSetInteger(0,lbn,OBJPROP_FONTSIZE,8);
      ObjectSetInteger(0,lbn,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,lbn,OBJPROP_HIDDEN,true);
     }
  }

void ClearDrawings()
  {
   int total=ObjectsTotal(0,0,-1);
   for(int i=total-1;i>=0;i--)
     {string n=ObjectName(0,i);if(StringFind(n,prefix)==0) ObjectDelete(0,n);}
  }

double MaxStrengthAcross()
  {
   double m=0;
   for(int i=0;i<resCount;i++) if(resZones[i].diedBar<0) m=MathMax(m,resZones[i].strength);
   for(int i=0;i<supCount;i++) if(supZones[i].diedBar<0) m=MathMax(m,supZones[i].strength);
   return m;
  }

double MaxVolAcross()
  {
   double m=0;
   for(int i=0;i<resCount;i++) if(resZones[i].diedBar<0) m=MathMax(m,resZones[i].volSum);
   for(int i=0;i<supCount;i++) if(supZones[i].diedBar<0) m=MathMax(m,supZones[i].volSum);
   return m;
  }

