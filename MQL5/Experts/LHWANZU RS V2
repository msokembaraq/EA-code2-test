bool IsLicensed()
  {
   uint acct = (uint)AccountInfoInteger(ACCOUNT_LOGIN);
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   uint now = (uint)(dt.year * 10000 + dt.mon * 100 + dt.day);

   if(ArraySize(g_licenses) == 0)
     { Print("lhwanzuRS: No licenses configured | Account=", acct); return false; }

   for(int i = 0; i < ArraySize(g_licenses); i++)
     {
      uint a = g_licenses[i].encAccount ^ LIC_KEY;
      uint e = g_licenses[i].encExpiry  ^ LIC_KEY;
      if(a == acct)
        {
         if(now <= e)
           {
            if(_UninitReason != REASON_CHARTCHANGE && _UninitReason != REASON_PARAMETERS)
               Print("lhwanzuRS: License valid | Account=", acct, " Expiry=", e);
            return true;
           }
         else
           { Print("lhwanzuRS: License EXPIRED | Account=", acct, " Expiry=", e, " Today=", now); return false; }
        }
     }
   Print("lhwanzuRS: Account not licensed | Account=", acct);
   return false;
  }

