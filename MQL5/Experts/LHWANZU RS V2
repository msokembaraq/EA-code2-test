//+------------------------------------------------------------------+
//| ENTRY/SL BUILDER (uses current TF ATR and current TF swings)    |
//+------------------------------------------------------------------+
string BuildEntryStr(int dir, double price, double atr)
  {
   double entryPad = atr * 0.5;
   double entryLow, entryHigh;
   if(dir == 1)
     { entryLow  = NormalizeDouble(price - entryPad, _Digits);
       entryHigh = NormalizeDouble(price,             _Digits); }
   else
     { entryLow  = NormalizeDouble(price,             _Digits);
       entryHigh = NormalizeDouble(price + entryPad,  _Digits); }

   double swingLevel = 0;
   double nearDist   = DBL_MAX;

   for(int k = 0; k < g_nLv; k++)
     {
      if(dir == 1 && !g_lv[k].isHigh)
        {
         if(g_lv[k].price < entryLow)
           { double d = entryLow - g_lv[k].price; if(d < nearDist) { nearDist = d; swingLevel = g_lv[k].price; } }
        }
      else if(dir == -1 && g_lv[k].isHigh)
        {
         if(g_lv[k].price > entryHigh)
           { double d = g_lv[k].price - entryHigh; if(d < nearDist) { nearDist = d; swingLevel = g_lv[k].price; } }
        }
     }

   bool swingValid = (swingLevel > 0 &&
                      (InpSLMaxATR <= 0 ||
                       MathAbs((dir==1 ? entryLow : entryHigh) - swingLevel) <= InpSLMaxATR * atr));

   double sl;
   if(swingValid)
      sl = NormalizeDouble(dir == 1 ? swingLevel - InpSLATRMult * atr
                                    : swingLevel + InpSLATRMult * atr, _Digits);
   else
      sl = NormalizeDouble(dir == 1 ? entryLow  - InpSLATRMult * atr
                                    : entryHigh + InpSLATRMult * atr, _Digits);

   return " | Entry:" + DoubleToString(entryLow, _Digits) + "-" + DoubleToString(entryHigh, _Digits) +
          " SL:" + DoubleToString(sl, _Digits);
  }

//+------------------------------------------------------------------+
//| ZONE GV CONFLUENCE TAG                                           |
//+------------------------------------------------------------------+
string ZoneTag(int dir, double price, double atr, datetime barTime)
  {
   if(!InpZoneGV || InpZoneGVExpiry <= 0) return "";
   string tag = "";
   long expirySeconds = (long)InpZoneGVExpiry * PeriodSeconds(InpSignalTF);

   // --- SR Zones / Liquidity Signals swing level tag ---
   if(GlobalVariableCheck("SRZONES_DIR") && GlobalVariableCheck("SRZONES_TIME") && GlobalVariableCheck("SRZONES_PRICE"))
     {
      double gvDir   = GlobalVariableGet("SRZONES_DIR");
      double gvPrice = GlobalVariableGet("SRZONES_PRICE");
      double gvTime  = GlobalVariableGet("SRZONES_TIME");
      if((int)gvDir == dir &&
         (long)barTime - (long)gvTime <= expirySeconds &&
         !(atr > 0 && MathAbs(price - gvPrice) > 2.0 * atr))
         tag += " ZONE";
     }

   // --- CHoCH tag — structure change confirmed in same direction ---
   if(GlobalVariableCheck("SPL_CHOCH_DIR") && GlobalVariableCheck("SPL_CHOCH_TIME"))
     {
      double chochDir  = GlobalVariableGet("SPL_CHOCH_DIR");
      double chochTime = GlobalVariableGet("SPL_CHOCH_TIME");
      if((int)chochDir == dir &&
         (long)barTime - (long)chochTime <= expirySeconds)
         tag += " CHoCH";
     }

   // --- MSS tag — FVG or OB zone entry in same direction ---
   if(GlobalVariableCheck("SPL_MSS_DIR") && GlobalVariableCheck("SPL_MSS_TIME"))
     {
      double mssDir  = GlobalVariableGet("SPL_MSS_DIR");
      double mssTime = GlobalVariableGet("SPL_MSS_TIME");
      if((int)mssDir == dir &&
         (long)barTime - (long)mssTime <= expirySeconds)
        {
         bool isFVG = GlobalVariableCheck("SPL_MSS_TYPE") && GlobalVariableGet("SPL_MSS_TYPE") > 0.5;
         tag += isFVG ? " FVG" : " OB";
        }
     }

   return tag;
  }

//+------------------------------------------------------------------+
//| MAIN CALCULATIONS                                                |
//+------------------------------------------------------------------+
int OnCalculate(const int rates_total,
                const int prev_calculated,
                const datetime &time[],
                const double   &open[],
                const double   &high[],
                const double   &low[],
                const double   &close[],
                const long     &tick_volume[],
                const long     &volume[],
                const int      &spread[])
  {
   if(rates_total < InpATRLen + 2) return 0;

   // --- Fresh load: restore persisted state or apply clean defaults ---
   if(prev_calculated == 0)
     {
      // Always rescan pivots — can't be persisted cheaply
      ArrayResize(g_lv, 0);
      g_nLv = 0;

      if(GvRestore())
        {
         if(InpPrintLog) Print("[STATE] Restored from GlobalVariables | Symbol=", Symbol(),
               " PullbackDir=", g_lastPullbackDir,
               " SlowRS=", g_curRSTrend);
         g_lastPullbackBar = -1;
         g_lastSignalBar   = -1;  // stale bar index invalid after reload — reset cooldown
        }
      else
        {
         // No prior save found — full clean init
         g_lastPullbackDir  = 0;
         g_lastPullbackTime = 0;
         g_lastPullbackBar  = -1;
         g_lastPullbackSlowDir = 0;
         g_curRSTrend       = 0;
         g_lastRBSSBRDir    = 0;
         g_lastRBSSBRTime   = 0;
         g_sniperState = WATCH_NONE; g_sniperDir = 0;
         g_sniperRSSlow = 0; g_sniperRSFast = 0;
         g_sniperConsHigh = 0; g_sniperConsLow = 0;
         g_sniperConsTime = 0; g_sniperLabel = "";
         g_lastSignalDir = 0;
         g_lastSignalBar = -1;
         g_lastRSDir     = 0;
         g_rangingNotified     = false;
         g_rangingLastReminder = 0;
         g_rangingBreakTime    = 0;
         g_rangeTradeActive    = false;
         g_rangeBuyTouches     = 0;
         g_rangeSellTouches    = 0;
         g_fibRangeBreakUp     = false;
         g_fibRangeBreakDown   = false;
         // Reset consolidation history on clean attach
         for(int _h=0;_h<HIST_MAX;_h++) { g_hist[_h].valid=false; g_hist[_h].high=0; g_hist[_h].low=0; g_hist[_h].confirmTime=0; g_hist[_h].breakDir=0; g_hist[_h].touches=0; }
         g_histCount = 0;
         g_po3State    = PO3_NONE; g_po3BreakDir = 0;
         g_po3BreakHigh = 0.0; g_po3BreakLow = 0.0;
         g_po3BarCount = 0; g_po3Notified = false; g_po3InRetest = false;
         g_po3RangeBreakDir = 0; g_po3RangeBreakBars = 0;
        }

      // ─── FIX #1: ALWAYS reset ranging state on fresh load ───────────────
      g_isRanging       = false;
      g_rangePH         = 0.0;
      g_rangePL         = 0.0;
      g_rangingNotified = false;  // always re-announce on fresh attach

      // ─── FIX #2: ALWAYS zero LTF bar time to force first-run gate pass ───
      // GvRestore() may have set g_lastLTFBarTime to the current live M1 bar.
      // This would cause the ltfLastTime == g_lastLTFBarTime gate to fire,
      // skipping pivot detection, RS engine, and all signal logic
      // on the first pass — the entire signal engine silently does nothing
      // until the NEXT M1 bar closes. Force 0 so the gate always passes once.
      g_lastLTFBarTime = 0;
     }

   // --- Current TF ATR (display + range + entry/SL) ---
   double atrRaw[];
   ArraySetAsSeries(atrRaw, true);
   if(CopyBuffer(g_atrHandle, 0, 0, rates_total, atrRaw) < rates_total) return 0;

   // Fill empty bars before ATR init
   for(int j = 0; j < InpATRLen && j < rates_total; j++)
     {
      BufRS1[j] = EMPTY_VALUE; BufRSColor1[j] = 0;
      BufRS2[j] = EMPTY_VALUE; BufRSColor2[j] = 0;
     }

   // --- Display buffers: RS drawn on current TF bars ---
   // NOTE: display lines use current TF close/ATR — visual only
   //       signal engine below uses LTF data
   double rollSeg1Disp   = close[InpATRLen];
   double rsTrend1Disp   = 1.0;
   double actSlope1Disp  = 0.0;
   bool   isFast1Disp    = false;

   double rollSeg2Disp   = close[InpATRLen];
   double rsTrend2Disp   = 1.0;
   double actSlope2Disp  = 0.0;
   bool   isFast2Disp    = false;

   BufRS1[InpATRLen]      = rollSeg1Disp;
   BufRSColor1[InpATRLen] = 0;
   BufRS2[InpATRLen]      = rollSeg2Disp;
   BufRSColor2[InpATRLen] = 0;

   for(int i = InpATRLen + 1; i < rates_total; i++)
     {
      double atr = atrRaw[rates_total - 1 - i];
      if(atr <= 0.0 || atr >= EMPTY_VALUE || !MathIsValidNumber(atr))
        {
         BufRS1[i]      = close[i]; BufRSColor1[i] = (rsTrend1Disp > 0) ? 0 : 1;
         BufRS2[i]      = close[i]; BufRSColor2[i] = (rsTrend2Disp > 0) ? 0 : 1;
         continue;
        }

      double dist1 = close[i] - rollSeg1Disp;
      bool bullRev1 = (rsTrend1Disp < 0) && (dist1  >  InpRSRevThresh * atr);
      bool bearRev1 = (rsTrend1Disp > 0) && (-dist1 >  InpRSRevThresh * atr);
      if(bullRev1) rsTrend1Disp = 1.0; else if(bearRev1) rsTrend1Disp = -1.0;
      bool nf1 = (MathAbs(dist1) > InpRSFastThresh * atr);
      if(bullRev1 || bearRev1 || (nf1 != isFast1Disp) || actSlope1Disp == 0.0)
        { isFast1Disp = nf1; actSlope1Disp = isFast1Disp ? atr/InpRSFastLen : atr/InpRSSlowLen; }
      rollSeg1Disp += rsTrend1Disp * actSlope1Disp;
      BufRS1[i]      = rollSeg1Disp;
      BufRSColor1[i] = (rsTrend1Disp > 0) ? 0 : 1;

      double dist2 = close[i] - rollSeg2Disp;
      bool bullRev2 = (rsTrend2Disp < 0) && (dist2  >  InpRSRevThresh * atr);
      bool bearRev2 = (rsTrend2Disp > 0) && (-dist2 >  InpRSRevThresh * atr);
      if(bullRev2) rsTrend2Disp = 1.0; else if(bearRev2) rsTrend2Disp = -1.0;
      bool nf2 = (MathAbs(dist2) > InpRSFastThresh * atr);
      if(bullRev2 || bearRev2 || (nf2 != isFast2Disp) || actSlope2Disp == 0.0)
        { isFast2Disp = nf2; actSlope2Disp = isFast2Disp ? atr/InpRSFastLen2 : atr/InpRSSlowLen2; }
      rollSeg2Disp += rsTrend2Disp * actSlope2Disp;
      BufRS2[i]      = rollSeg2Disp;
      BufRSColor2[i] = (rsTrend2Disp > 0) ? 0 : 1;
     }

   // ================================================================
   // SIGNAL ENGINE — runs on LTF bars
   // Only re-evaluate when a new LTF bar has closed
   // ================================================================

   // Fetch LTF rates
   MqlRates ltfRates[];
   ArraySetAsSeries(ltfRates, false);
   int ltfTotal = CopyRates(NULL, InpSignalTF, 0, 3000, ltfRates);
   if(ltfTotal < InpATRLen + 2) return rates_total;

   // Confirmed last closed LTF bar
   int ltfLast = ltfTotal - 2; // rates_total-2 equivalent on LTF
   datetime ltfLastTime = ltfRates[ltfLast].time;

   // Only process once per new LTF bar
   if(ltfLastTime == g_lastLTFBarTime) return rates_total;
   g_lastLTFBarTime = ltfLastTime;

   // Fetch LTF ATR
   double atrLTF[];
   ArraySetAsSeries(atrLTF, false);
   if(CopyBuffer(g_atrLTFHandle, 0, 0, ltfTotal, atrLTF) < ltfTotal) return rates_total;

   // Current TF ATR for entry/SL and range (use last confirmed current bar)
   double atrCur = atrRaw[1]; // index 1 = last confirmed current bar (series reversed)

   // --- Pivot Detection Loop — M1 LTF ---
   // Runs regardless of InpEnableRange — pivots feed FibRecalc/FibTag/SD engine.
   // InpEnableRange only gates the ranging/signal-block behaviour in i_RangeCheck.
   {
      int pivStart = (prev_calculated == 0) ? InpSwingLeft : MathMax(InpSwingLeft, ltfLast - 50);
      for(int p = pivStart; p <= ltfLast; p++)
        {
         int pBar = p - InpSwingRight;
         if(pBar < InpSwingLeft || pBar + InpSwingRight > ltfLast) continue;

         double ph = ltfRates[pBar].high;
         double pl = ltfRates[pBar].low;
         datetime pt = ltfRates[pBar].time;

         bool isph = true;
         for(int k = 1; k <= InpSwingLeft  && isph; k++) if(ltfRates[pBar-k].high >= ph) isph = false;
         for(int k = 1; k <= InpSwingRight && isph; k++) if(ltfRates[pBar+k].high >= ph) isph = false;
         if(isph)
           {
            bool exists = false;
            for(int k = 0; k < g_nLv; k++)
               if(g_lv[k].isHigh && g_lv[k].t1 == pt) { exists = true; break; }
            if(!exists) AddLevel(ph, ph, pl, pt, true);
           }

         bool ispl = true;
         for(int k = 1; k <= InpSwingLeft  && ispl; k++) if(ltfRates[pBar-k].low <= pl) ispl = false;
         for(int k = 1; k <= InpSwingRight && ispl; k++) if(ltfRates[pBar+k].low <= pl) ispl = false;
         if(ispl)
           {
            bool exists = false;
            for(int k = 0; k < g_nLv; k++)
               if(!g_lv[k].isHigh && g_lv[k].t1 == pt) { exists = true; break; }
            if(!exists) AddLevel(pl, ph, pl, pt, false);
           }

         for(int j = 0; j < g_nLv; j++)
           {
            if(g_lv[j].broken) continue;
            if(p < ltfLast)
              {
               if(g_lv[j].isHigh ? (ltfRates[p].close > g_lv[j].price) : (ltfRates[p].close < g_lv[j].price))
                  g_lv[j].broken = true;
              }
           }
        }
     }

   // Recalc external fib anchors — signal TF only
   // Note: pivot detection always runs — g_fibValid independent of InpEnableRange
   // When range is active, fib is already anchored to range box — skip pivot hunt
   if(!g_isRanging)
      FibRecalc(ltfRates[ltfLast].close, atrCur);

   // --- RS Signal Engine on Signal TF ---
   double rollSeg1  = ltfRates[InpATRLen].close;
   double rsTrend1  = 1.0, actSlope1 = 0.0;
   bool   isFast1   = false;
   int    bsFlip1   = 0;

   double rollSeg2  = ltfRates[InpATRLen].close;
   double rsTrend2  = 1.0, actSlope2 = 0.0;
   bool   isFast2   = false;
   int    bsFlip2   = 0;

   for(int i = InpATRLen + 1; i <= ltfLast; i++)
     {
      double atr = atrLTF[i];
      if(atr <= 0.0 || atr >= EMPTY_VALUE || !MathIsValidNumber(atr)) continue;

      // Slow RS
      double d1    = ltfRates[i].close - rollSeg1;
      bool   bR1   = (rsTrend1 < 0) && ( d1 >  InpRSRevThresh * atr);
      bool   brR1  = (rsTrend1 > 0) && (-d1 >  InpRSRevThresh * atr);
      double prev1 = rsTrend1;
      if(bR1) rsTrend1 = 1.0; else if(brR1) rsTrend1 = -1.0;
      if(rsTrend1 != prev1) bsFlip1 = 0; else bsFlip1++;
      bool nf1 = (MathAbs(d1) > InpRSFastThresh * atr);
      if(bR1 || brR1 || (nf1 != isFast1) || actSlope1 == 0.0)
        { isFast1 = nf1; actSlope1 = isFast1 ? atr/InpRSFastLen : atr/InpRSSlowLen; }
      rollSeg1 += rsTrend1 * actSlope1;

      // Fast RS
      double d2    = ltfRates[i].close - rollSeg2;
      bool   bR2   = (rsTrend2 < 0) && ( d2 >  InpRSRevThresh * atr);
      bool   brR2  = (rsTrend2 > 0) && (-d2 >  InpRSRevThresh * atr);
      double prev2 = rsTrend2;
      if(bR2) rsTrend2 = 1.0; else if(brR2) rsTrend2 = -1.0;
      if(rsTrend2 != prev2) bsFlip2 = 0; else bsFlip2++;
      bool nf2 = (MathAbs(d2) > InpRSFastThresh * atr);
      if(bR2 || brR2 || (nf2 != isFast2) || actSlope2 == 0.0)
        { isFast2 = nf2; actSlope2 = isFast2 ? atr/InpRSFastLen2 : atr/InpRSSlowLen2; }
      rollSeg2 += rsTrend2 * actSlope2;
     }

   // Update RS trend tracker for RBS/SBR gate
   int newTrend = (rsTrend1 > 0) ? 1 : -1;
   if(newTrend != g_curRSTrend && g_curRSTrend != 0)
      g_lastRBSSBRDir = 0;
   g_curRSTrend = newTrend;

   // --- Range Detection (M1 LTF — bsFlip1 now available) ---
   i_RangeCheck(ltfRates, atrLTF, ltfTotal, ltfLast, bsFlip1);

   // LTF close price at signal bar — used for entry/SL
   double ltfClose = ltfRates[ltfLast].close;

   // Signal TF label for push message
   string tfLabel = EnumToString(InpSignalTF);
   StringReplace(tfLabel, "PERIOD_", "");

   // Separation check
   double rsSep     = MathAbs(rollSeg1 - rollSeg2);
   bool   linesClose = (InpRSMinSep > 0 && atrLTF[ltfLast] > 0 &&
                        rsSep < InpRSMinSep * atrLTF[ltfLast]);

if(!linesClose && (InpEngineMode == ENGINE_AB_ONLY || InpEngineMode == ENGINE_BOTH))
{
      string alertMsg = "";
      bool   trigger  = false;
      int    curSlowDir = (rsTrend1 > 0) ? 1 : -1;
      int    curFastDir = (rsTrend2 > 0) ? 1 : -1;

      // ================================================================
      // UNIFIED PULLBACK STATE MACHINE
      // A++    — Both flip same dir within InpAlignBars (no pullback) → immediate trend change
      // Phase 1 — Fast flips OPPOSITE to Slow → A+ SCALP + store pullback
      // Phase 2A — Fast realigns with Slow (Slow unchanged) → B+
      // Phase 2B — Slow flips to match Fast within InpAlignBars → A+ CONFIRMED HOLD
      // Phase 2C — Slow flips to match Fast, then Fast confirms → B++
      // No timeout — state persists until resolved by one of the above
      // ================================================================

      if(InpAlertA_Plus &&
         curSlowDir == curFastDir &&       // Both lines same direction
         bsFlip1 <= InpAlignBars &&        // Slow flipped within window
         bsFlip2 <= InpAlignBars &&        // Fast flipped within window
         (bsFlip1 == 0 || bsFlip2 == 0) && // At least one flipped this bar
         (curFastDir == 1 ? rollSeg2 > rollSeg1 : rollSeg2 < rollSeg1)) // Position guard — no crossover
        {
         // A++ — double flip into same direction, immediate trend change
         // Fires regardless of pullback state — overrides everything
         alertMsg = (curFastDir == 1) ? "🟢 A++ BUY" : "🔴 A++ SELL";
         trigger  = true;
         // Clear any stale pullback state
         g_lastPullbackDir = 0; g_lastPullbackTime = 0; g_lastPullbackBar = -1; g_lastPullbackSlowDir = 0;
         if(InpPrintLog) Print("[A++] Double flip | slowFlip=", bsFlip1, " fastFlip=", bsFlip2,
               " dir=", curFastDir, " | ", Symbol());
        }
      else if(InpAlertA_Plus &&
         bsFlip2 == 0 &&               // Fast just flipped this bar
         curFastDir != curSlowDir &&    // Fast opposes Slow → pullback/counter
         g_lastPullbackDir == 0)        // No existing pullback active
        {
         // Phase 1 — A+ SCALP + arm pullback state
         alertMsg = (curFastDir == 1) ? "🟢 A+ BUY SCALP" : "🔴 A+ SELL SCALP";
         trigger  = true;
         g_lastPullbackDir     = curFastDir;
         g_lastPullbackTime    = ltfLastTime;
         g_lastPullbackBar     = ltfLast;
         g_lastPullbackSlowDir = curSlowDir;   // remember slow direction at pullback start
         if(InpPrintLog) Print("[A+ SCALP] Pullback armed | fastDir=", curFastDir,
               " slowDir=", curSlowDir, " | ", Symbol());
        }
      else if(g_lastPullbackDir != 0)
        {
         // Pullback is active — check for resolution
         int pbDir   = g_lastPullbackDir;         // direction fast was pointing at pullback
         int pbSlow  = g_lastPullbackSlowDir;     // slow direction at pullback start
         int pbBars  = ltfLast - g_lastPullbackBar;

         if(InpAlertBPlusPlus &&
            curSlowDir == pbDir &&                // Slow has now flipped to match Fast's new direction
            curFastDir == pbDir &&                // Fast confirms same direction
            pbSlow != pbDir)                      // Slow was opposite at pullback start (confirms flip happened)
           {
            // Phase 2C — B++ : Slow flipped, Fast now confirms
            alertMsg = (pbDir == 1) ? "🔥🟢 B++ BUY" : "🔥🔴 B++ SELL";
            trigger  = true;
            if(InpPrintLog) Print("[B++] Fired | dir=", pbDir,
                  " pullback at ", TimeToString(g_lastPullbackTime), " bars=", pbBars, " | ", Symbol());
            g_lastPullbackDir = 0; g_lastPullbackTime = 0; g_lastPullbackBar = -1; g_lastPullbackSlowDir = 0;
           }
         else if(InpAlertA_Plus &&
                 bsFlip1 == 0 &&                  // Slow just flipped this bar
                 curSlowDir == pbDir &&            // Slow flipped to match Fast's new direction
                 pbBars <= InpAlignBars)           // Within confirmation window
           {
            // Phase 2B — A+ CONFIRMED HOLD : Slow confirms Fast's direction quickly
            alertMsg = (pbDir == 1) ? "🟢 A+ BUY CONFIRMED HOLD" : "🔴 A+ SELL CONFIRMED HOLD";
            trigger  = true;
            if(InpPrintLog) Print("[A+ CONFIRMED] Slow confirmed fast dir=", pbDir,
                  " within ", pbBars, " bars | ", Symbol());
            g_lastPullbackDir = 0; g_lastPullbackTime = 0; g_lastPullbackBar = -1; g_lastPullbackSlowDir = 0;
           }
         else if(InpAlertB_Plus &&
                 bsFlip2 == 0 &&                  // Fast just flipped this bar
                 curFastDir == curSlowDir &&       // Fast re-aligned with Slow
                 curSlowDir == pbSlow &&           // Slow unchanged since pullback — original trend resumed
                 (curFastDir == 1 ? rollSeg2 > rollSeg1 : rollSeg2 < rollSeg1)) // Fast never crossed slow
           {
            // Phase 2A — B+ : Fast re-aligned with unchanged Slow, no line crossover
            alertMsg = (curFastDir == 1) ? "🟢 B+ BUY" : "🔴 B+ SELL";
            trigger  = true;
            if(InpPrintLog) Print("[B+] Fast realigned with Slow | dir=", curFastDir, " | ", Symbol());
            g_lastPullbackDir = 0; g_lastPullbackTime = 0; g_lastPullbackBar = -1; g_lastPullbackSlowDir = 0;
           }
         else if(curFastDir != pbDir && bsFlip2 == 0)
           {
            // Fast flipped opposite of stored pullback direction — invalidate
            if(InpPrintLog) Print("[PULLBACK] Invalidated — fast flipped opposite | was dir=", pbDir, " | ", Symbol());
            g_lastPullbackDir = 0; g_lastPullbackTime = 0; g_lastPullbackBar = -1; g_lastPullbackSlowDir = 0;
           }
        }

      if(trigger && alertMsg != "")
        {
         int  sigDir = (StringFind(alertMsg, "BUY") >= 0) ? 1 : -1;

         // While ranging — A+/B+/B++ fire normally
         // Range engine owns boundary touches (RANGE BUY/SELL)
         // RS momentum signals always fire — they are the core engine

         string entrySuffix = BuildEntryStr(sigDir, ltfClose, atrCur);
         string zt          = ZoneTag(sigDir, ltfClose, atrCur, ltfLastTime);

         // PO3 gate — suppress same direction as fake break during WATCH/RETEST
         bool po3Suppressed = ((g_po3State == PO3_WATCH || g_po3State == PO3_RETEST) && sigDir == g_po3BreakDir);
         if(po3Suppressed)
            if(InpPrintLog) Print("[PO3] Signal SUPPRESSED — same dir as fake break (",
                  (sigDir==1?"BUY":"SELL"), ") | ", Symbol());

         // Cooldown gate — suppress opposite signal within InpAlignBars bars
         int barsSinceLast = (g_lastSignalBar >= 0) ? (ltfLast - g_lastSignalBar) : 999;
         bool cooldownBlock = (sigDir != g_lastRSDir &&
                               barsSinceLast > 0 &&
                               barsSinceLast < InpAlignBars);
         if(cooldownBlock)
            if(InpPrintLog) Print("[COOLDOWN] Signal suppressed — opposite fired only ",
                  barsSinceLast, " bars ago | ", Symbol());

         if(!po3Suppressed && !cooldownBlock)
           {
            // PO3 tag — opposite direction during watch = early warning
            string po3Tag  = ((g_po3State == PO3_WATCH || g_po3State == PO3_RETEST) && sigDir != g_po3BreakDir) ? " PO3" : "";
            string fibTag  = FibTag(ltfClose, sigDir);
            string fvgTag  = FVGZoneTag(sigDir, ltfRates[ltfLast].time);
            string histTag = HistTag(ltfClose, sigDir, atrCur);

            {
               string fullMsg = alertMsg + po3Tag + zt + fibTag + fvgTag + histTag + " | " + Symbol() + " " + tfLabel + entrySuffix;
               string fullPfx = ConfidencePrefix(fullMsg) + fullMsg;
               if(sigDir != g_lastSignalDir)
                 { if(InpSendPush) SendNotification(fullPfx); if(InpSendAlert) Alert(fullPfx); }
               if(InpPrintLog) Print(fullPfx);

               // --- ARM SNIPER WATCH --- only on non-silenced signals
               if(InpSniperMode)
                 {
                  if(sigDir == g_lastSignalDir)
                     if(InpPrintLog) Print("[SNIPER] SKIPPED — same dir as last signal (",
                           (sigDir==1?"BUY":"SELL"), ") | ", Symbol());
                  else
                    {
                     if(g_sniperDir != 0 && g_sniperDir != sigDir)
                        if(InpPrintLog) Print("[SNIPER] Watch CANCELLED — opposite signal | ", Symbol());
                     g_sniperState    = WATCH_PULLBACK;
                     g_sniperDir      = sigDir;
                     g_sniperRSSlow   = rollSeg1;
                     g_sniperRSFast   = rollSeg2;
                     g_sniperLabel    = alertMsg + po3Tag;
                     g_sniperConsHigh = 0; g_sniperConsLow = 0; g_sniperConsTime = 0;
                     if(InpPrintLog) Print("[SNIPER] Watch ARMED | dir=", sigDir,
                           " SlowRS=", DoubleToString(rollSeg1, _Digits),
                           " FastRS=", DoubleToString(rollSeg2, _Digits), " | ", Symbol());
                    }
                 }

               // Update direction lock — only on non-silenced signals
               g_lastSignalDir = sigDir;
               g_lastSignalBar = ltfLast;
               g_lastRSDir     = sigDir;  // RS-only cooldown — isolated from PO3
              }
           }
        }
     } // end RS engine loop

   // ================================================================
   // SNIPER ENGINE — runs each LTF bar while watch is active
   // ================================================================
   if(InpSniperMode && !g_isRanging && g_sniperState != WATCH_NONE && ltfLast >= 1)
     {
      double barHigh  = ltfRates[ltfLast].high;
      double barLow   = ltfRates[ltfLast].low;
      double barClose = ltfRates[ltfLast].close;
      double barOpen  = ltfRates[ltfLast].open;
      double slowLine = rollSeg1;
      double fastLine = rollSeg2;

      static bool s_closePrinted = false;  // reset when state changes
      static bool s_setupPrinted = false;

      if(g_sniperState == WATCH_PULLBACK)
        {
         s_setupPrinted = false; // reset for next setup phase
         bool touchedSlow = (g_sniperDir == 1) ? (barLow  <= slowLine) : (barHigh >= slowLine);
         bool touchedFast = (g_sniperDir == 1) ? (barLow  <= fastLine) : (barHigh >= fastLine);

         // Print CLOSE once when nearest line within 1×ATR
         if(InpPrintLog && !s_closePrinted)
           {
            double distSlow = (g_sniperDir == 1) ? barLow - slowLine : slowLine - barHigh;
            double distFast = (g_sniperDir == 1) ? barLow - fastLine : fastLine - barHigh;
            double nearest  = MathMin(MathAbs(distSlow), MathAbs(distFast));
            if(nearest <= atrLTF[ltfLast] * 1.0)
              {
               Print("[SNIPER] CLOSE | dir=", (g_sniperDir==1?"BUY":"SELL"),
                     " | NearestDist=", DoubleToString(nearest, _Digits),
                     " | Slow=", DoubleToString(slowLine, _Digits),
                     " Fast=", DoubleToString(fastLine, _Digits),
                     " | Bar=", TimeToString(ltfRates[ltfLast].time), " | ", Symbol());
               s_closePrinted = true;
              }
           }

         if(touchedSlow || touchedFast)
           {
            g_sniperState    = WATCH_SETUP;
            g_sniperConsHigh = barHigh;
            g_sniperConsLow  = barLow;
            g_sniperConsTime = ltfRates[ltfLast].time;
            s_closePrinted   = false; // reset for next pullback
            if(InpPrintLog) Print("[SNIPER] TOUCHED ", (touchedSlow?"SLOW":"FAST"), " RS line | dir=", (g_sniperDir==1?"BUY":"SELL"),
                  " | Bar=", TimeToString(g_sniperConsTime),
                  " | ConsH=", DoubleToString(barHigh, _Digits),
                  " ConsL=", DoubleToString(barLow, _Digits), " | ", Symbol());
           }
        }
      else if(g_sniperState == WATCH_SETUP)
        {
         if(g_sniperDir == 1 && barLow  < g_sniperConsLow)  g_sniperConsLow  = barLow;
         if(g_sniperDir == -1 && barHigh > g_sniperConsHigh) g_sniperConsHigh = barHigh;

         bool breakOut = (g_sniperDir == 1)  ? (barClose > g_sniperConsHigh && barOpen <= g_sniperConsHigh)
                                              : (barClose < g_sniperConsLow  && barOpen >= g_sniperConsLow);
         bool overshot = (g_sniperDir == 1)
                         ? (barClose < MathMin(slowLine, fastLine) - atrLTF[ltfLast] * 2.0)
                         : (barClose > MathMax(slowLine, fastLine) + atrLTF[ltfLast] * 2.0);

         // Print SETUP once on entry to setup state
         if(InpPrintLog && !s_setupPrinted)
           {
            Print("[SNIPER] SETUP | dir=", (g_sniperDir==1?"BUY":"SELL"),
                  " | ConsH=", DoubleToString(g_sniperConsHigh, _Digits),
                  " ConsL=", DoubleToString(g_sniperConsLow, _Digits),
                  " | Watching for break | ", Symbol());
            s_setupPrinted = true;
           }

         if(overshot)
           {
            g_sniperState = WATCH_PULLBACK;
            g_sniperConsHigh = 0; g_sniperConsLow = 0; g_sniperConsTime = 0;
            s_setupPrinted = false; s_closePrinted = false;
            if(InpPrintLog) Print("[SNIPER] OVERSHOT — reset to WATCH_PULLBACK | ", Symbol());
           }
         else if(breakOut)
           {
            string entrySuffix = BuildEntryStr(g_sniperDir, barClose, atrCur);
            string zt          = ZoneTag(g_sniperDir, barClose, atrCur, ltfRates[ltfLast].time);
            string tfLbl       = EnumToString(InpSignalTF);
            StringReplace(tfLbl, "PERIOD_", "");
            string sniperMsg = "🎯 " + g_sniperLabel + zt + " | " + Symbol() + " " + tfLbl + entrySuffix;
            if(InpSendPush)  SendNotification(sniperMsg);
            if(InpSendAlert) Alert(sniperMsg);
            if(InpPrintLog)  Print(sniperMsg);
            g_sniperState = WATCH_NONE; g_sniperDir = 0;
            g_sniperConsHigh = 0; g_sniperConsLow = 0;
            g_sniperConsTime = 0; g_sniperLabel = "";
            s_setupPrinted = false; s_closePrinted = false;
           }
        }
     }

   // Increment range break bar counter — expires after 20 bars
   if(g_po3RangeBreakDir != 0)
     {
      g_po3RangeBreakBars++;
      if(g_po3RangeBreakBars > 20)
        { g_po3RangeBreakDir = 0; g_po3RangeBreakBars = 0; }
     }

   // ================================================================
   // RANGE TRADE ENGINE — buy low / sell high while ranging
   // Fib + hist gate always evaluated when ranging (g_isRanging=true),
   // regardless of InpRangeTrade or g_rangeTradeActive.
   // Alerts only fire when InpRangeTrade=true AND g_rangeTradeActive=true.
   // Max InpRangeMaxTouches per boundary (default 2), then silent
   // PO3_WATCH = range broke = silent regardless
   // ================================================================
   if(g_isRanging && g_po3State == PO3_NONE && ltfLast >= 1)
     {
      double rtClose  = ltfRates[ltfLast].close;
      double rtHigh   = ltfRates[ltfLast].high;
      double rtLow    = ltfRates[ltfLast].low;
      double rtRange  = g_rangePH - g_rangePL;
      double rtAtr    = atrCur;
      double touchDist = InpRangeTouchATR * rtAtr;
      double slAtr    = InpSLATRMult * rtAtr;

      // ── BUY TOUCH — price near range floor ──────────────────────
      // Signal TF gate: slow RS must agree BUY — no counter-trend range buys
      bool nearFloor = (rtLow <= g_rangePL + touchDist &&
                        rtClose > g_rangePL - touchDist);
      if(nearFloor && !g_rangeBuyArmed)
        {
         g_rangeBuyArmed = true;
         // Always compute fib/hist tags so silence gate works regardless of InpRangeTrade
         string fibRBTag = FibTag(rtClose, 1);
         string fvgRBTag = FVGZoneTag(1, ltfRates[ltfLast].time);
         string hstRBTag = HistTag(rtClose, 1, atrCur);
         bool rbSilenced = (StringFind(hstRBTag, "⚠️") >= 0) ||
                           (StringFind(fibRBTag, "⚠️") >= 0);
         if(InpRangeTrade && g_rangeTradeActive)
           {
            if(g_curRSTrend != 1)
              {
               if(InpPrintLog) Print("[RANGE BUY] Suppressed — signal TF RS SELL | ", Symbol());
              }
            else if(g_rangeBuyTouches < InpRangeMaxTouches)
              {
               g_rangeBuyTouches++;
               double slPrice  = NormalizeDouble(g_rangePL - slAtr, _Digits);
               double tpPrice  = NormalizeDouble(g_rangePH, _Digits);
               string touchStr = IntegerToString(g_rangeBuyTouches) + "/" +
                                 IntegerToString(InpRangeMaxTouches);
               string msg = "🟢 RANGE BUY [" + touchStr + "]" + fibRBTag + fvgRBTag + hstRBTag +
                            " | " + Symbol() + " " + tfLabel +
                            " | Entry:" + DoubleToString(g_rangePL, _Digits) +
                            "-" + DoubleToString(g_rangePL + touchDist, _Digits) +
                            " TP:" + DoubleToString(tpPrice, _Digits) +
                            " SL:" + DoubleToString(slPrice, _Digits) +
                            " | Box:" + DoubleToString(g_rangePL, _Digits) +
                            "-" + DoubleToString(g_rangePH, _Digits);
               if(!rbSilenced)
                 {
                  string rbPfx = ConfidencePrefix(msg) + msg;
                  if(InpSendPush) SendNotification(rbPfx); if(InpSendAlert) Alert(rbPfx); if(InpPrintLog) Print(rbPfx);
                 }
               else
                  if(InpPrintLog) Print("[RANGE BUY] Silenced — fib/hist opposing | ", Symbol());
              }
            else
              {
               if(InpPrintLog) Print("[RANGE TRADE] BUY touch ", g_rangeBuyTouches + 1,
                     " — max reached, silent | Box:", DoubleToString(g_rangePL, _Digits),
                     "-", DoubleToString(g_rangePH, _Digits), " | ", Symbol());
              }
           }
         else
           {
            // Range trade off — still log fib/hist opposition for awareness
            if(rbSilenced && InpPrintLog)
               Print("[RANGE BUY] Fib/hist opposing (range trade off) | ", fibRBTag, hstRBTag, " | ", Symbol());
           }
        }
      if(!nearFloor) g_rangeBuyArmed = false;  // reset arm when price leaves floor zone

      // ── SELL TOUCH — price near range ceiling ───────────────────
      // Signal TF gate: slow RS must agree SELL — no counter-trend range sells
      bool nearCeiling = (rtHigh >= g_rangePH - touchDist &&
                          rtClose < g_rangePH + touchDist);
      if(nearCeiling && !g_rangeSellArmed)
        {
         g_rangeSellArmed = true;
         // Always compute fib/hist tags so silence gate works regardless of InpRangeTrade
         string fibRSTag = FibTag(rtClose, -1);
         string fvgRSTag = FVGZoneTag(-1, ltfRates[ltfLast].time);
         string hstRSTag = HistTag(rtClose, -1, atrCur);
         bool rsSilenced2 = (StringFind(hstRSTag, "⚠️") >= 0) ||
                            (StringFind(fibRSTag, "⚠️") >= 0);
         if(InpRangeTrade && g_rangeTradeActive)
           {
            if(g_curRSTrend != -1)
              {
               if(InpPrintLog) Print("[RANGE SELL] Suppressed — signal TF RS BUY | ", Symbol());
              }
            else if(g_rangeSellTouches < InpRangeMaxTouches)
              {
               g_rangeSellTouches++;
               double slPrice  = NormalizeDouble(g_rangePH + slAtr, _Digits);
               double tpPrice  = NormalizeDouble(g_rangePL, _Digits);
               string touchStr = IntegerToString(g_rangeSellTouches) + "/" +
                                 IntegerToString(InpRangeMaxTouches);
               string msg = "🔴 RANGE SELL [" + touchStr + "]" + fibRSTag + fvgRSTag + hstRSTag +
                            " | " + Symbol() + " " + tfLabel +
                            " | Entry:" + DoubleToString(g_rangePH - touchDist, _Digits) +
                            "-" + DoubleToString(g_rangePH, _Digits) +
                            " TP:" + DoubleToString(tpPrice, _Digits) +
                            " SL:" + DoubleToString(slPrice, _Digits) +
                            " | Box:" + DoubleToString(g_rangePL, _Digits) +
                            "-" + DoubleToString(g_rangePH, _Digits);
               if(!rsSilenced2)
                 {
                  string rsPfx = ConfidencePrefix(msg) + msg;
                  if(InpSendPush) SendNotification(rsPfx); if(InpSendAlert) Alert(rsPfx); if(InpPrintLog) Print(rsPfx);
                 }
               else
                  if(InpPrintLog) Print("[RANGE SELL] Silenced — fib/hist opposing | ", Symbol());
              }
            else
              {
               if(InpPrintLog) Print("[RANGE TRADE] SELL touch ", g_rangeSellTouches + 1,
                     " — max reached, silent | Box:", DoubleToString(g_rangePL, _Digits),
                     "-", DoubleToString(g_rangePH, _Digits), " | ", Symbol());
              }
           }
         else
           {
            // Range trade off — still log fib/hist opposition for awareness
            if(rsSilenced2 && InpPrintLog)
               Print("[RANGE SELL] Fib/hist opposing (range trade off) | ", fibRSTag, hstRSTag, " | ", Symbol());
           }
        }
      if(!nearCeiling) g_rangeSellArmed = false;  // reset arm when price leaves ceiling zone
     }

   // ================================================================
   // SD EARLY ENTRY ENGINE — fires at SD-1/SD-2 after range break
   // Requires: InpSDEarlyEntry=true + FVG/OB GV active + range broke
   // NO RS confirmation — risky early counter-trend entry
   // Toggle: InpSDEarlyEntry (default false)
   // ================================================================
   if(InpSDEarlyEntry && g_fibValid && ltfLast >= 1 &&
      (g_fibRangeBreakUp || g_fibRangeBreakDown))
     {
      static datetime s_sdLastFireTime = 0;
      datetime curSDTime = ltfRates[ltfLast].time;
      double   sdClose   = ltfRates[ltfLast].close;

      // Only fire once per bar
      if(curSDTime != s_sdLastFireTime)
        {
         // Reuse cached SD levels from FibCalcLevels() — identical values
         double sd1L = g_fibSD1L;  // SD-1 discount
         double sd2L = g_fibSD2L;  // SD-2 extreme discount
         double sd1H = g_fibSD1H;  // SD+1 premium
         double sd2H = g_fibSD2H;  // SD+2 extreme premium
         double zone = atrCur * InpRangeTouchATR;

         // BUY — price at SD discount after SELL break
         bool atSD1Buy = g_fibRangeBreakDown && MathAbs(sdClose - sd1L) <= zone;
         bool atSD2Buy = g_fibRangeBreakDown && MathAbs(sdClose - sd2L) <= zone;
         // SELL — price at SD premium after BUY break
         bool atSD1Sell = g_fibRangeBreakUp && MathAbs(sdClose - sd1H) <= zone;
         bool atSD2Sell = g_fibRangeBreakUp && MathAbs(sdClose - sd2H) <= zone;

         int    sdDir     = 0;
         string sdLabel   = "";
         double sdLevel   = 0;
         if(atSD2Buy)       { sdDir =  1; sdLabel = "SD-2 EXTREME DISCOUNT" + (g_fibSD2LConfirmed?" 📦HIST":""); sdLevel = sd2L; }
         else if(atSD1Buy)  { sdDir =  1; sdLabel = "SD-1 DISCOUNT"         + (g_fibSD1LConfirmed?" 📦HIST":""); sdLevel = sd1L; }
         else if(atSD2Sell) { sdDir = -1; sdLabel = "SD+2 EXTREME PREMIUM"  + (g_fibSD2HConfirmed?" 📦HIST":""); sdLevel = sd2H; }
         else if(atSD1Sell) { sdDir = -1; sdLabel = "SD+1 PREMIUM"          + (g_fibSD1HConfirmed?" 📦HIST":""); sdLevel = sd1H; }

         if(sdDir != 0)
           {
            // Check FVG/OB GV active in same direction
            string fvgSD  = FVGZoneTag(sdDir, curSDTime);
            bool   hasFVG = (fvgSD != "" && StringFind(fvgSD, "⚠️") < 0);

            if(hasFVG)
              {
               double slSD  = NormalizeDouble(sdDir == 1 ?
                              sdLevel - InpSLATRMult * atrCur :
                              sdLevel + InpSLATRMult * atrCur, _Digits);
               double tpSD  = NormalizeDouble(sdDir == 1 ? g_fibLow : g_fibHigh, _Digits);
               string esSuffix = " | Entry:" + DoubleToString(sdClose, _Digits) +
                                 " TP:" + DoubleToString(tpSD, _Digits) +
                                 " SL:" + DoubleToString(slSD, _Digits);
               string hstSDTag = HistTag(sdClose, sdDir, atrCur);
               string sdMsg = "🎯 " + sdLabel + (sdDir==1?" EARLY BUY":" EARLY SELL") +
                              fvgSD + hstSDTag + " | " + Symbol() + " " + tfLabel + esSuffix +
                              " ⚠️ COUNTER-TREND";
               if(InpSendPush)  SendNotification(sdMsg);
               if(InpSendAlert) Alert(sdMsg);
               if(InpPrintLog)  Print(sdMsg);
               s_sdLastFireTime = curSDTime;
              }
            else if(InpPrintLog)
               Print("[SD ENGINE] ", sdLabel, " reached but no FVG/OB GV active — silent | ", Symbol());
           }
        }
     }

   // ================================================================
   // PO3 ENGINE — Break / Retest / Confirm
   // Phase 1: Break detected — silent, watch for retest
   // Phase 2: Retest — price returns to broken level
   //   2A: Retest fails (closes back inside range) → 🎯 PO3 opposite
   //   2B: Retest holds (closes outside) → ▶ GENUINE BREAK
   // Phase 3: No retest in 30 bars → ▶ GENUINE BREAK
   // Phase 4: Back inside range → watch for double break → ▶ STRONG BREAK
   // ================================================================
   if(g_po3State != PO3_NONE)
     {
      g_po3BarCount++;
      double curClose = ltfRates[ltfLast].close;
      double retestZone = atrCur * 0.5;  // within 0.5×ATR of broken level = retest zone

      // ── PHASE 1: WATCHING FOR RETEST ────────────────────────────
      if(g_po3State == PO3_WATCH)
        {
         // Must be at least 2 bars outside range before retest qualifies
         if(g_po3BarCount < 2) return rates_total;

         // Check if price has returned to retest the broken level
         bool inRetestZone = false;
         if(g_po3BreakDir == 1)  // broke high — retest = price near g_po3BreakHigh
            inRetestZone = (curClose <= g_po3BreakHigh + retestZone &&
                            curClose >= g_po3BreakHigh - retestZone);
         else                    // broke low — retest = price near g_po3BreakLow
            inRetestZone = (curClose >= g_po3BreakLow - retestZone &&
                            curClose <= g_po3BreakLow + retestZone);

         if(inRetestZone && !g_po3InRetest)
           {
            g_po3InRetest = true;
            g_po3BarCount = 0; // reset bar count from retest
            g_po3State    = PO3_RETEST;
            if(InpPrintLog) Print("[PO3] RETEST DETECTED | BreakDir=",
                  (g_po3BreakDir==1?"BUY":"SELL"),
                  " | Price=", DoubleToString(curClose,_Digits), " | ", Symbol());
           }
         // No retest in 30 bars — genuine momentum break
         else if(g_po3BarCount >= 30)
           {
            string dir = (g_po3BreakDir == 1) ? "BUY" : "SELL";
            string msg  = "▶ RANGE BROKEN — BIAS " + dir + " | " + Symbol() +
                          " | " + DoubleToString(curClose, _Digits);
            if(InpSendPush)  SendNotification(msg);
            if(InpSendAlert) Alert(msg);
            if(InpPrintLog)  Print(msg + " [no retest — momentum confirmed]");
            // Save momentum break to history (NFP/news spikes — most important ranges)
            HistSaveRange(g_po3BreakHigh, g_po3BreakLow, ltfRates[ltfLast].time, g_po3BreakDir,
                          g_po3TouchesAtBreak);
            if(g_fibValid) FibCalcLevels(atrCur);  // immediate SD confirmation update
            g_lastSignalDir     = g_po3BreakDir;  // suppress immediate opposite RS signals
            g_po3RangeBreakDir  = g_po3BreakDir;
            g_po3RangeBreakBars = 0;
            g_po3State = PO3_NONE; g_po3BreakDir = 0;
            g_po3BreakHigh = 0; g_po3BreakLow = 0;
            g_po3BarCount = 0; g_po3Notified = false; g_po3InRetest = false;
           }
        }

      // ── PHASE 2: RETEST IN PROGRESS ─────────────────────────────
      else if(g_po3State == PO3_RETEST)
        {
         // 2A: Retest FAILS — price closes back INSIDE range
         bool closedInsideRange = (curClose < g_po3BreakHigh && curClose > g_po3BreakLow);
         if(closedInsideRange)
           {
            // Fake break confirmed — fire PO3 opposite
            int oppDir = -g_po3BreakDir;
            string entrySuffix = BuildEntryStr(oppDir, curClose, atrCur);
            // Fib gate — suppress push if price in opposing fib zone after range break
            // SELL break → discount flips to SBR SELL → PO3 BUY push suppressed
            // BUY break  → premium flips to RBS BUY  → PO3 SELL push suppressed
            bool po3FibBlock = (oppDir ==  1 && g_fibRangeBreakDown) ||
                               (oppDir == -1 && g_fibRangeBreakUp);
            string fibWarn   = po3FibBlock ? " ⚠️ FIB ZONE OPPOSING" : FibTag(curClose, oppDir);
            string hstPO3Tag = HistTag(curClose, oppDir, atrCur);
            string msg = "🎯 PO3 " + (oppDir==1?"BUY":"SELL") + fibWarn + hstPO3Tag + " | " +
                         Symbol() + " " + tfLabel + entrySuffix;
            if(!po3FibBlock)
              {
               if(InpSendPush)  SendNotification(msg);
               if(InpSendAlert) Alert(msg);
               if(InpPrintLog)  Print(msg);
              }
            // po3FibBlock = fib zone opposes counter-signal — silenced completely
            g_lastSignalDir = oppDir;
            // Move to INSIDE state — watch for double break
            g_po3State    = PO3_INSIDE;
            g_po3BarCount = 0;
            g_po3Notified = true;
            if(InpPrintLog) Print("[PO3] RETEST FAILED — inside range | watching for double break | ", Symbol());
           }
         // 2B: Retest HOLDS — closes back OUTSIDE in break direction
         else
           {
            bool confirmedBuy  = (g_po3BreakDir == 1  && curClose > g_po3BreakHigh);
            bool confirmedSell = (g_po3BreakDir == -1 && curClose < g_po3BreakLow);
            if(confirmedBuy || confirmedSell)
              {
               string dir = (g_po3BreakDir == 1) ? "BUY" : "SELL";
               string msg = "▶ RANGE BROKEN — BIAS " + dir + " | " + Symbol() +
                            " | " + DoubleToString(curClose, _Digits);
               if(InpSendPush)  SendNotification(msg);
               if(InpSendAlert) Alert(msg);
               if(InpPrintLog)  Print(msg + " [retest held — confirmed]");
               // Save confirmed range to history
               HistSaveRange(g_po3BreakHigh, g_po3BreakLow, ltfRates[ltfLast].time, g_po3BreakDir,
                             g_po3TouchesAtBreak);
               g_lastSignalDir     = g_po3BreakDir;  // suppress immediate opposite RS signals
               g_po3RangeBreakDir  = g_po3BreakDir;
               g_po3RangeBreakBars = 0;
               g_po3State = PO3_NONE; g_po3BreakDir = 0;
               g_po3BreakHigh = 0; g_po3BreakLow = 0;
               g_po3BarCount = 0; g_po3Notified = false; g_po3InRetest = false;
              }
            // Still in retest zone — wait
            else if(g_po3BarCount >= 10)
              {
               // Retest zone timed out — treat as still in watch
               g_po3State    = PO3_WATCH;
               g_po3InRetest = false;
               g_po3BarCount = 0;
               if(InpPrintLog) Print("[PO3] RETEST INCONCLUSIVE — back to watch | ", Symbol());
              }
           }
        }

      // ── PHASE 3: INSIDE RANGE — WATCH FOR DOUBLE BREAK ──────────
      else if(g_po3State == PO3_INSIDE)
        {
         // Price breaks SAME side again = double break = strong confirmed move
         bool doubleBuy  = (g_po3BreakDir == 1  && curClose > g_po3BreakHigh);
         bool doubleSell = (g_po3BreakDir == -1 && curClose < g_po3BreakLow);

         if(doubleBuy || doubleSell)
           {
            string dir = (g_po3BreakDir == 1) ? "BUY" : "SELL";
            string msg = "▶ RANGE BROKEN — BIAS " + dir + " STRONG | " + Symbol() +
                         " | " + DoubleToString(curClose, _Digits);
            if(InpSendPush)  SendNotification(msg);
            if(InpSendAlert) Alert(msg);
            if(InpPrintLog)  Print(msg + " [double break confirmed]");
            // Save confirmed range to history
            HistSaveRange(g_po3BreakHigh, g_po3BreakLow, ltfRates[ltfLast].time, g_po3BreakDir,
                          g_po3TouchesAtBreak);
            g_lastSignalDir     = g_po3BreakDir;  // suppress immediate opposite RS signals
            g_po3RangeBreakDir  = g_po3BreakDir;
            g_po3RangeBreakBars = 0;
            g_po3State = PO3_NONE; g_po3BreakDir = 0;
            g_po3BreakHigh = 0; g_po3BreakLow = 0;
            g_po3BarCount = 0; g_po3Notified = false; g_po3InRetest = false;
           }
         // Price breaks OPPOSITE side = new manipulation in other direction
         else if((g_po3BreakDir == 1 && curClose < g_po3BreakLow) ||
                 (g_po3BreakDir == -1 && curClose > g_po3BreakHigh))
           {
            // Already fired PO3 opposite — this is genuine opposite move
            if(InpPrintLog) Print("[PO3] Opposite break while inside — resetting | ", Symbol());
            g_po3State = PO3_NONE; g_po3BreakDir = 0;
            g_po3BreakHigh = 0; g_po3BreakLow = 0;
            g_po3BarCount = 0; g_po3Notified = false; g_po3InRetest = false;
           }
         // Expire inside after 30 bars — market moved on
         else if(g_po3BarCount >= 30)
           {
            if(InpPrintLog) Print("[PO3] INSIDE expired — resetting | ", Symbol());
            g_po3State = PO3_NONE; g_po3BreakDir = 0;
            g_po3BreakHigh = 0; g_po3BreakLow = 0;
            g_po3BarCount = 0; g_po3Notified = false; g_po3InRetest = false;
           }
        }
     }

   // ── RBS/SBR — signal TF structure breaks, gated by signal TF RS only ──────────
   if(InpAlertRBSSBR && !g_isRanging && (InpEngineMode == ENGINE_RBS_ONLY || InpEngineMode == ENGINE_BOTH))
     {
      datetime curBarTime = ltfRates[ltfLast].time;
      if(curBarTime != g_lastRBSSBRTime)
        {
         g_lastRBSSBRTime = curBarTime;
         double prevClose = ltfRates[ltfLast - 1].close;
         double curClose  = ltfRates[ltfLast].close;

         int    bestJ = -1; double bestDist = DBL_MAX; int bestDir = 0;

         for(int j = 0; j < g_nLv; j++)
           {
            if(!g_lv[j].broken || g_lv[j].flipAlerted) continue;

            if(g_lv[j].isHigh && prevClose <= g_lv[j].top && curClose > g_lv[j].top)
              {
               if(InpTrendOnlyMode && g_curRSTrend != 1) continue;
               if(g_lastRBSSBRDir == 1) continue;
               // PO3 gate — suppress same direction as fake break during watch/retest
               if((g_po3State == PO3_WATCH || g_po3State == PO3_RETEST) && g_po3BreakDir == 1) continue;
               double dist = MathAbs(curClose - g_lv[j].price);
               if(dist < bestDist) { bestDist = dist; bestJ = j; bestDir = 1; }
              }
            else if(!g_lv[j].isHigh && prevClose >= g_lv[j].bot && curClose < g_lv[j].bot)
              {
               if(InpTrendOnlyMode && g_curRSTrend != -1) continue;
               if(g_lastRBSSBRDir == -1) continue;
               // PO3 gate — suppress same direction as fake break during watch/retest
               if((g_po3State == PO3_WATCH || g_po3State == PO3_RETEST) && g_po3BreakDir == -1) continue;
               double dist = MathAbs(curClose - g_lv[j].price);
               if(dist < bestDist) { bestDist = dist; bestJ = j; bestDir = -1; }
              }
           }

         if(bestJ >= 0)
           {
            g_lv[bestJ].flipAlerted = true;
            g_lastRBSSBRDir = bestDir;
            string tfLabel2 = EnumToString(InpSignalTF);
            StringReplace(tfLabel2, "PERIOD_", "");
            if(bestDir == 1)
              {
               double sl  = NormalizeDouble(g_lv[bestJ].bot - InpSLATRMult * atrCur, _Digits);
               string zt  = ZoneTag(1, curClose, atrCur, curBarTime);
               string po3RBSTag = (g_po3RangeBreakDir == 1) ? " PO3" : "";
               string fibRBSTag = FibTag(curClose, 1);
               string fvgRBSTag = FVGZoneTag(1, curBarTime);
               string hstRBSTag = HistTag(curClose, 1, atrCur);
               string msg = "🟢 RBS BUY" + po3RBSTag + zt + fibRBSTag + fvgRBSTag + hstRBSTag + " | " + Symbol() + " " + tfLabel2 +
                            " | Entry:" + DoubleToString(g_lv[bestJ].bot, _Digits) +
                            "-" + DoubleToString(g_lv[bestJ].top, _Digits) +
                            " SL:" + DoubleToString(sl, _Digits);
               bool rbsSilenced = (StringFind(hstRBSTag, "⚠️") >= 0) ||
                                  (StringFind(fibRBSTag, "⚠️") >= 0);
               if(!rbsSilenced)
                 {
                  string rbsPfx = ConfidencePrefix(msg) + msg;
                  if(InpSendPush)  SendNotification(rbsPfx);
                  if(InpSendAlert) Alert(rbsPfx);
                  if(InpPrintLog)  Print(rbsPfx);
                 }
              }
            else
              {
               double sl  = NormalizeDouble(g_lv[bestJ].top + InpSLATRMult * atrCur, _Digits);
               string zt  = ZoneTag(-1, curClose, atrCur, curBarTime);
               string po3SBRTag = (g_po3RangeBreakDir == -1) ? " PO3" : "";
               string fibSBRTag = FibTag(curClose, -1);
               string fvgSBRTag = FVGZoneTag(-1, curBarTime);
               string hstSBRTag = HistTag(curClose, -1, atrCur);
               string msg = "🔴 SBR SELL" + po3SBRTag + zt + fibSBRTag + fvgSBRTag + hstSBRTag + " | " + Symbol() + " " + tfLabel2 +
                            " | Entry:" + DoubleToString(g_lv[bestJ].bot, _Digits) +
                            "-" + DoubleToString(g_lv[bestJ].top, _Digits) +
                            " SL:" + DoubleToString(sl, _Digits);
               bool sbrSilenced = (StringFind(hstSBRTag, "⚠️") >= 0) ||
                                  (StringFind(fibSBRTag, "⚠️") >= 0);
               if(!sbrSilenced)
                 {
                  string sbrPfx = ConfidencePrefix(msg) + msg;
                  if(InpSendPush)  SendNotification(sbrPfx);
                  if(InpSendAlert) Alert(sbrPfx);
                  if(InpPrintLog)  Print(sbrPfx);
                 }
              }
           }
        }
     }

   return rates_total;
  }

//+------------------------------------------------------------------+
//| RANGE CHECK — M1 LTF based                                      |
//| Uses LTF pivot array, LTF ATR, LTF RS flip count for chop       |
//| Box locked on ranging start — not updated until range ends       |
//+------------------------------------------------------------------+
bool i_RangeCheck(const MqlRates &ltfRates[], const double &atrLTF[], int ltfTotal, int ltfLast, int rsFlip1)
  {
   if(!InpEnableRange) { g_isRanging = false; return false; }

   // Don't detect new ranging while PO3 is active — wait for full resolution
   // PO3_WATCH = range broke, watching retest
   // PO3_RETEST = retest detected, confirming
   // Either state = old range context still active
   if(g_po3State == PO3_WATCH || g_po3State == PO3_RETEST) return false;

   // Use LTF ATR at last confirmed bar
   double atr = atrLTF[ltfLast];
   if(atr <= 0.0 || atr >= EMPTY_VALUE) return false;

   // Current LTF close
   double c = ltfRates[ltfLast].close;

   bool wasRanging = g_isRanging;
   double oldPH    = g_rangePH;
   double oldPL    = g_rangePL;

   // If already ranging — only check if price broke the locked box
   if(wasRanging)
     {
      bool brokeHigh = (c > oldPH);
      bool brokeLow  = (c < oldPL);

      if(brokeHigh || brokeLow)
        {
         g_isRanging           = false;
         g_rangingNotified     = false;
         g_rangingLastReminder = 0;
         g_rangingBreakTime    = ltfRates[ltfLast].time;
         // Set fib role-flip flags — premium/discount zones flip on break direction
         g_fibRangeBreakUp   = brokeHigh;
         g_fibRangeBreakDown = brokeLow;
         // Snapshot touches before reset — used by HistSaveRange for strength field
         g_po3TouchesAtBreak = g_rangeBuyTouches + g_rangeSellTouches;
         // Deactivate range trade mode — silent until next confirmed range
         if(g_rangeTradeActive)
           {
            g_rangeTradeActive = false;
            g_rangeBuyTouches  = 0;
            g_rangeSellTouches = 0;
            if(InpPrintLog) Print("[RANGE TRADE] Deactivated — range broken | ", Symbol());
           }

         // Arm PO3 watch — only if not already in PO3 watch
         if(g_po3State == PO3_NONE)
           {
            g_po3State     = PO3_WATCH;
            g_po3BreakDir  = brokeHigh ? 1 : -1;
            g_po3BreakHigh = oldPH;
            g_po3BreakLow  = oldPL;
            g_po3BarCount  = 0;
            g_po3Notified  = false;
            if(InpPrintLog) Print("[PO3] ARMED | BreakDir=", (brokeHigh?"BUY":"SELL"),
                  " | Box=", DoubleToString(oldPL,_Digits), "-", DoubleToString(oldPH,_Digits),
                  " | Break@", DoubleToString(c,_Digits), " | ", Symbol());
           }
         else
            if(InpPrintLog) Print("[PO3] Already watching — ignoring new break | ", Symbol());
        }
      // Else still inside box — stay ranging, return
      else return false;
     }

   // --- Not ranging — scan LTF pivots to find fresh box ---
   // Only use pivots within 3×ATR of current price — prevents distant stale pivots
   // from anchoring one side of the box after a directional move
   double recentPH = 0.0, recentPL = DBL_MAX;
   datetime recentPHTime = 0, recentPLTime = 0;
   double proximityLimit = atr * 5.0;

   for(int k = 0; k < g_nLv; k++)
     {
      if(g_lv[k].broken) continue;
      // Skip pivots too far from current price
      if(MathAbs(g_lv[k].price - c) > proximityLimit) continue;
      if( g_lv[k].isHigh && g_lv[k].t1 > recentPHTime) { recentPH = g_lv[k].price; recentPHTime = g_lv[k].t1; }
      if(!g_lv[k].isHigh && g_lv[k].t1 > recentPLTime) { recentPL = g_lv[k].price; recentPLTime = g_lv[k].t1; }
     }

   bool hasBothPivots = (recentPHTime > 0 && recentPLTime > 0 && recentPL < DBL_MAX);
   if(!hasBothPivots) return false;

   // Cooldown after range break — 10 signal TF bars before new range can be declared
   if(g_rangingBreakTime > 0 && ltfRates[ltfLast].time - g_rangingBreakTime < (datetime)(10 * PeriodSeconds(InpSignalTF)))
      return false;

   double rw = recentPH - recentPL;
   bool inBox      = (c <= recentPH && c >= recentPL);
   bool wideEnough = (rw > 1.0 * atr);
   bool tight      = (rw < InpRangeMinATR * atr);

   bool isChoppy = (rsFlip1 > 20);

   bool newRanging = (inBox && wideEnough && tight) || (inBox && wideEnough && isChoppy);

   if(newRanging)
     {
      bool isNewBox = (!g_isRanging ||
                       MathAbs(recentPH - g_rangePH) > _Point ||
                       MathAbs(recentPL - g_rangePL) > _Point);
      g_isRanging = true;
      g_rangePH   = recentPH;
      g_rangePL   = recentPL;
      // Reset fib role-flip flags on any new box — independent of InpRangeTrade
      if(isNewBox) { g_fibRangeBreakUp = false; g_fibRangeBreakDown = false; }
      // Anchor fib to range box — range IS the fib framework
      // SD levels computed from range boundaries = reversal targets
      if(isNewBox && InpFibFilter)
        {
         g_fibLow  = g_rangePL;
         g_fibHigh = g_rangePH;
         FibCalcLevels(atrLTF[ltfLast]);
         if(InpPrintLog) Print("[FIB] Range-anchored Low=", DoubleToString(g_fibLow, _Digits),
               " High=", DoubleToString(g_fibHigh, _Digits),
               " Range=", DoubleToString(g_fibHigh - g_fibLow, 2),
               " SD-1=", DoubleToString(g_fibSD1L, _Digits),
               " SD+1=", DoubleToString(g_fibSD1H, _Digits));
        }
      // Activate range trade mode and reset touch counters on fresh box
      if(isNewBox && InpRangeTrade)
        {
         g_rangeTradeActive   = true;
         g_rangeBuyTouches    = 0;
         g_rangeSellTouches   = 0;
         g_rangeBuyArmed      = false;
         g_rangeSellArmed     = false;
         if(InpPrintLog) Print("[RANGE TRADE] Armed | Box:",
               DoubleToString(g_rangePL, _Digits), "-", DoubleToString(g_rangePH, _Digits),
               " MaxTouches:", InpRangeMaxTouches, " | ", Symbol());
        }
      if(!g_rangingNotified)
        {
         string msg = "⏸ RANGING — WAIT BREAK OUT | " + Symbol() + " | Box:" +
                      DoubleToString(g_rangePL, _Digits) + "-" + DoubleToString(g_rangePH, _Digits);
         if(InpSendPush)  SendNotification(msg);
         if(InpSendAlert) Alert(msg);
         if(InpPrintLog)  Print(msg);
         g_rangingNotified     = true;
         g_rangingLastReminder = ltfRates[ltfLast].time;
        }
      else
        {
         // 30-min reminder while still ranging
         datetime barTime = ltfRates[ltfLast].time;
         if(barTime - g_rangingLastReminder >= 1800)
           {
            string msg = "⏸ STILL RANGING — WAIT BREAK OUT | " + Symbol() + " | Box:" +
                         DoubleToString(g_rangePL, _Digits) + "-" + DoubleToString(g_rangePH, _Digits);
            if(InpSendPush)  SendNotification(msg);
            if(InpSendAlert) Alert(msg);
            if(InpPrintLog)  Print(msg);
            g_rangingLastReminder = barTime;
           }
        }
      return true;
     }

   return false;
  }
