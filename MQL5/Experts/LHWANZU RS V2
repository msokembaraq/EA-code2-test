//+------------------------------------------------------------------+
//| CONFIDENCE PREFIX — 🏦 BANK / 💎 GOLD                           |
//| Scores confluence tags in a built message string                 |
//| FIB ✅ = +1 | HIST ✅ = +1 | PO3 tag = +1 | RBS/SBR ✅ = +1    |
//| score >= 3 → 🏦 BANK   (Tier 1 — full size)                     |
//| score == 2 → 💎 GOLD   (Tier 2 — normal size)                   |
//| score <= 1 → no prefix (read the tags yourself)                 |
//+------------------------------------------------------------------+
string ConfidencePrefix(const string &msg)
  {
   int score = 0;
   // A++ double flip — inherently strong signal, starts at +1
   if(StringFind(msg, "A++") >= 0) score++;
   if(StringFind(msg, "✅") >= 0)
     {
      // FIB zone confirmed
      if(StringFind(msg, "📐") >= 0 && StringFind(msg, "✅") >= 0) score++;
      // HIST confirmed
      if(StringFind(msg, "📦") >= 0 && StringFind(msg, "✅") >= 0) score++;
      // PO3 confirmation
      if(StringFind(msg, "PO3") >= 0) score++;
      // RBS or SBR role-flip confirmed
      if(StringFind(msg, "RBS BUY ✅") >= 0 ||
         StringFind(msg, "SBR SELL ✅") >= 0) score++;
     }
   if(score >= 3) return "🏦 BANK | ";
   if(score == 2) return "💎 GOLD | ";
   return "";
  }

//+------------------------------------------------------------------+
//| FIB ENGINE — External PD/SD zone filter                         |
//| Anchors from nearest unbroken g_lv[] pivots above/below price   |
//| Directional lock: uses signal TF slow trend (g_curRSTrend)        |
//+------------------------------------------------------------------+
void FibCalcLevels(double atrForTol = 0)
  {
   if(g_fibHigh <= g_fibLow) { g_fibValid = false; return; }
   double r  = g_fibHigh - g_fibLow;
   g_fibSD1H = g_fibHigh + 0.5 * r;
   g_fibSD2H = g_fibHigh + 1.0 * r;
   g_fibSD1L = g_fibLow  - 0.5 * r;
   g_fibSD2L = g_fibLow  - 1.0 * r;
   g_fibValid = true;

   // Check SD levels against historical ranges — structural confirmation
   // ATR-based tolerance (consistent with HistTag) capped at 15% of range
   double tol = (atrForTol > 0 && atrForTol < EMPTY_VALUE) ?
                MathMin(InpHistProximityATR * atrForTol, r * 0.15) :
                r * 0.15;  // fallback to 15% if ATR unavailable
   g_fibSD1HConfirmed = false;
   g_fibSD2HConfirmed = false;
   g_fibSD1LConfirmed = false;
   g_fibSD2LConfirmed = false;

   if(!InpHistEnabled) return;
   datetime now = TimeCurrent();
   long expiryMs = (long)InpHistExpiryDays * 86400;
   int maxSlots  = MathMin(InpHistMaxRanges, HIST_MAX);
   for(int h = 0; h < maxSlots; h++)
     {
      if(!g_hist[h].valid) continue;
      if(InpHistExpiryDays > 0 && (long)now - (long)g_hist[h].confirmTime > expiryMs) continue;
      double boundaries[2];
      boundaries[0] = g_hist[h].high;
      boundaries[1] = g_hist[h].low;
      for(int b = 0; b < 2; b++)
        {
         if(!g_fibSD1HConfirmed && MathAbs(g_fibSD1H - boundaries[b]) <= tol) g_fibSD1HConfirmed = true;
         if(!g_fibSD2HConfirmed && MathAbs(g_fibSD2H - boundaries[b]) <= tol) g_fibSD2HConfirmed = true;
         if(!g_fibSD1LConfirmed && MathAbs(g_fibSD1L - boundaries[b]) <= tol) g_fibSD1LConfirmed = true;
         if(!g_fibSD2LConfirmed && MathAbs(g_fibSD2L - boundaries[b]) <= tol) g_fibSD2LConfirmed = true;
        }
     }
   if(InpPrintLog)
     {
      if(g_fibSD1HConfirmed) Print("[FIB] SD+1=", DoubleToString(g_fibSD1H,_Digits), " CONFIRMED by historical range | ", Symbol());
      if(g_fibSD2HConfirmed) Print("[FIB] SD+2=", DoubleToString(g_fibSD2H,_Digits), " CONFIRMED by historical range | ", Symbol());
      if(g_fibSD1LConfirmed) Print("[FIB] SD-1=", DoubleToString(g_fibSD1L,_Digits), " CONFIRMED by historical range | ", Symbol());
      if(g_fibSD2LConfirmed) Print("[FIB] SD-2=", DoubleToString(g_fibSD2L,_Digits), " CONFIRMED by historical range | ", Symbol());
     }
  }

void FibRecalc(double curPrice, double atr = 0)
  {
   double nearH = 0, nearL = 0;
   double nearHDist = DBL_MAX, nearLDist = DBL_MAX;
   for(int k = 0; k < g_nLv; k++)
     {
      if(g_lv[k].broken) continue;
      if(g_lv[k].isHigh && g_lv[k].price > curPrice)
        { double d = g_lv[k].price - curPrice; if(d < nearHDist) { nearHDist = d; nearH = g_lv[k].price; } }
      if(!g_lv[k].isHigh && g_lv[k].price < curPrice)
        { double d = curPrice - g_lv[k].price; if(d < nearLDist) { nearLDist = d; nearL = g_lv[k].price; } }
     }
   if(nearH <= 0 || nearL <= 0 || nearH <= nearL) return;
   // Minimum range guard — new range must be at least InpRangeMinATR × ATR
   // Prevents micro re-anchoring from tiny swing lows/highs
   if(atr > 0 && (nearH - nearL) < atr * InpRangeMinATR)
     {
      if(InpPrintLog) Print("[FIB] Re-anchor skipped — range too small: ",
            DoubleToString(nearH - nearL, 2), " < ", DoubleToString(atr * InpRangeMinATR, 2),
            " | ", Symbol());
      return;
     }
   bool wasValid = g_fibValid;
   bool highSame = (MathAbs(nearH - g_fibHigh) <= _Point);
   bool lowSame  = (MathAbs(nearL  - g_fibLow)  <= _Point);
   if(wasValid && highSame && lowSame) return;
   // Directional lock — signal TF slow RS trend
   if(wasValid)
     {
      int msDir = (g_curRSTrend > 0) ? 1 : (g_curRSTrend < 0) ? -1 : 0;
      // Bull: ceiling only moves up
      //       floor can move down only if drop > 2×ATR (genuine new HL, not micro swing)
      // Bear: floor only moves down
      //       ceiling can move up only if rise > 2×ATR (genuine new LH, not micro swing)
      double tolerance = (atr > 0) ? atr * 2.0 : 0;
      if(msDir ==  1)
        {
         if(nearH < g_fibHigh - _Point) return;
         if(nearL < g_fibLow - _Point - tolerance) return;  // floor: allow small HL, block large drops
        }
      if(msDir == -1)
        {
         if(nearL > g_fibLow + _Point) return;
         if(nearH > g_fibHigh + _Point + tolerance) return;  // ceiling: allow small LH, block large rises
        }
     }
   g_fibHigh = nearH;
   g_fibLow  = nearL;
   FibCalcLevels(atr);
   if(InpPrintLog) Print("[FIB] ", wasValid?"Re-anchored":"Anchored",
         " Low=", DoubleToString(g_fibLow, _Digits),
         " High=", DoubleToString(g_fibHigh, _Digits),
         " Range=", DoubleToString(g_fibHigh - g_fibLow, 2));
  }

// Returns: 2=SD level  1=PD zone  0=EQ (suppress push)
// After range break — premium/discount zones flip role
int FibZoneClass(double price)
  {
   if(!g_fibValid || !InpFibFilter) return 1;  // filter off = always allow
   double r = g_fibHigh - g_fibLow;
   if(r <= 0) return 1;
   double p = (price - g_fibLow) / r;
   // SD levels — always PD class regardless of break direction
   if(p <= -0.25 || p >= 1.35) return 2;
   // After break UP: 0.618-1.05 zone flips to RBS BUY (PD class)
   if(g_fibRangeBreakUp && p >= 0.618 && p <= 1.05) return 1;
   // After break DOWN: 0.0-0.318 zone flips to SBR SELL (PD class)
   if(g_fibRangeBreakDown && p >= 0.0 && p <= 0.318) return 1;
   // Standard PD zones (no break)
   if(p <= 0.236 || (p >= 0.786 && p < 1.05)) return 1;
   return 0;  // EQ — suppress
  }

// Appends fib zone tag to signal message — zones flip on range break direction
string FibTag(double price, int sigDir)
  {
   if(!g_fibValid) return "";
   double r = g_fibHigh - g_fibLow;
   if(r <= 0) return "";
   double p = (price - g_fibLow) / r;
   string zone = "";
   int    bias = 0;
   if(p <= -0.75)      { zone = "SD-2 DISCOUNT";    bias =  1; if(g_fibSD2LConfirmed) zone += " 📦HIST"; }
   else if(p <= -0.25) { zone = "SD-1 DISCOUNT";    bias =  1; if(g_fibSD1LConfirmed) zone += " 📦HIST"; }
   else if(p <=  0.10)
     { bias = g_fibRangeBreakDown ? -1 :  1;
       zone = g_fibRangeBreakDown ? "FIB 0 SBR SELL" : "FIB 0 DISCOUNT"; }
   else if(p <=  0.236)
     { bias = g_fibRangeBreakDown ? -1 :  1;
       zone = g_fibRangeBreakDown ? "FIB 0.236 SBR SELL" : "FIB 0.236 DISC"; }
   else if(p <=  0.318)
     { bias = g_fibRangeBreakDown ? -1 :  0;
       zone = g_fibRangeBreakDown ? "FIB 0.318 SBR SELL" : "FIB 0.318 EQ"; }
   else if(p <=  0.50)  { zone = "FIB 0.5 EQ";       bias =  0; }
   else if(p <=  0.618)
     { bias = g_fibRangeBreakUp ?  1 :  0;
       zone = g_fibRangeBreakUp ? "FIB 0.618 RBS BUY" : "FIB 0.618 EQ"; }
   else if(p <=  0.786)
     { bias = g_fibRangeBreakUp ?  1 : -1;
       zone = g_fibRangeBreakUp ? "FIB 0.786 RBS BUY" : "FIB 0.786 PREM"; }
   else if(p <=  1.05)
     { bias = g_fibRangeBreakUp ?  1 : -1;
       zone = g_fibRangeBreakUp ? "FIB 1.0 RBS BUY" : "FIB 1.0 PREM"; }
   else if(p <=  1.35)  { zone = "SD+1 PREMIUM";     bias = -1; if(g_fibSD1HConfirmed) zone += " 📦HIST"; }
   else                 { zone = "SD+2 PREMIUM";     bias = -1; if(g_fibSD2HConfirmed) zone += " 📦HIST"; }
   string tag = " | 📐 " + zone;
   if(sigDir != 0)
     { if(bias == sigDir) tag += " ✅"; else if(bias == -sigDir) tag += " ⚠️"; }
   tag += " [0=" + DoubleToString(g_fibLow, _Digits) +
          " 1="  + DoubleToString(g_fibHigh, _Digits) + "]";
   return tag;
  }

// Reads SPL_FVG_TOUCH_* GVs from Liquidity Signals
// Returns tag string with FVG/OB confluence info
// sigDir: 1=buy signal -1=sell signal
string FVGZoneTag(int sigDir, datetime ltfBarTime)
  {
   if(InpFVGExpiry <= 0) return "";
   if(!GlobalVariableCheck("SPL_FVG_TOUCH_TIME")) return "";
   datetime touchTime = (datetime)(long)GlobalVariableGet("SPL_FVG_TOUCH_TIME");
   long     expiryMs  = (long)InpFVGExpiry * (long)PeriodSeconds(InpSignalTF);
   if((long)ltfBarTime - (long)touchTime > expiryMs) return "";
   // Guard all dependent GV reads — fail safely to neutral if missing
   if(!GlobalVariableCheck("SPL_FVG_TOUCH_DIR") ||
      !GlobalVariableCheck("SPL_FVG_TOUCH_TYPE")) return "";
   int    touchDir  = (int)GlobalVariableGet("SPL_FVG_TOUCH_DIR");
   int    touchType = (int)GlobalVariableGet("SPL_FVG_TOUCH_TYPE");
   double touchTop  = GlobalVariableCheck("SPL_MSS_TOP") ? GlobalVariableGet("SPL_MSS_TOP") : 0;
   double touchBot  = GlobalVariableCheck("SPL_MSS_BOT") ? GlobalVariableGet("SPL_MSS_BOT") : 0;
   string typeStr   = (touchType == 1) ? "FVG" : "OB";
   string zoneStr   = (touchTop > 0 && touchBot > 0) ?
                      " [" + DoubleToString(touchBot, _Digits) +
                      "-"  + DoubleToString(touchTop, _Digits) + "]" : "";
   // Mutually exclusive — no dead branch
   return (touchDir == sigDir) ? " | 🔷 " + typeStr + " ✅" + zoneStr
                                : " | 🔷 " + typeStr + " ⚠️" + zoneStr;
  }

// Save confirmed range to history — circular buffer, oldest overwritten
// Called when range break is confirmed (PO3 confirm or double break)
void HistSaveRange(double high, double low, datetime t, int breakDir, int touches)
  {
   if(!InpHistEnabled) return;
   if(high <= 0 || low <= 0 || high <= low) return;
   int maxSlots = MathMin(InpHistMaxRanges, HIST_MAX);
   // Find oldest slot or first empty
   int   slot     = 0;
   datetime oldest = TimeCurrent();
   for(int h = 0; h < maxSlots; h++)
     {
      if(!g_hist[h].valid) { slot = h; break; }
      if(g_hist[h].confirmTime < oldest)
        { oldest = g_hist[h].confirmTime; slot = h; }
     }
   g_hist[slot].high        = high;
   g_hist[slot].low         = low;
   g_hist[slot].confirmTime = t;
   g_hist[slot].breakDir    = breakDir;
   g_hist[slot].touches     = touches;
   g_hist[slot].valid       = true;
   // g_histCount not used for loop bounds — validity flags gate all loops
   if(InpPrintLog) Print("[HIST] Saved range ", DoubleToString(low, _Digits),
         "-", DoubleToString(high, _Digits),
         " BreakDir=", (breakDir==1?"BUY":"SELL"),
         " Touches=", touches, " slot=", slot, " | ", Symbol());
  }

// Check proximity to saved historical ranges — returns tag string
// Returns closest matching range tag or ""
string HistTag(double price, int sigDir, double atr)
  {
   if(!InpHistEnabled || atr <= 0 || atr >= EMPTY_VALUE || !MathIsValidNumber(atr)) return "";
   int    maxSlots  = MathMin(InpHistMaxRanges, HIST_MAX);
   double threshold = InpHistProximityATR * atr;
   datetime now     = TimeCurrent();
   long   expiryMs  = (long)InpHistExpiryDays * 86400;
   string bestTag   = "";
   double bestDist  = DBL_MAX;
   for(int h = 0; h < maxSlots; h++)
     {
      if(!g_hist[h].valid) continue;
      // Expiry check
      if(InpHistExpiryDays > 0 && (long)now - (long)g_hist[h].confirmTime > expiryMs) continue;
      double distH = MathAbs(price - g_hist[h].high);
      double distL = MathAbs(price - g_hist[h].low);
      double dist  = MathMin(distH, distL);
      if(dist > threshold) continue;
      if(dist >= bestDist) continue;
      bestDist = dist;
      // Determine role — did price break up or down from this range?
      string rangeStr = DoubleToString(g_hist[h].low, _Digits) +
                        "-" + DoubleToString(g_hist[h].high, _Digits);
      bool nearHigh  = (distH < distL);
      // ICT/SMC role-flip semantics:
      // SELL break: both high AND low are bearish zones (resistance/continuation)
      // BUY break:  both low AND high are bullish zones (support/continuation)
      // Near HIGH after SELL break = SBR resistance = SELL aligned
      // Near LOW  after SELL break = bearish continuation = SELL aligned (NOT BUY)
      // Near LOW  after BUY break  = RBS support = BUY aligned
      // Near HIGH after BUY break  = bullish continuation = BUY aligned
      bool alignedBuy  = (g_hist[h].breakDir ==  1);  // BUY break = entire range is BUY territory
      bool alignedSell = (g_hist[h].breakDir == -1);  // SELL break = entire range is SELL territory
      string align = "";
      if(sigDir ==  1 && alignedBuy)  align = " ✅";
      if(sigDir == -1 && alignedSell) align = " ✅";
      if(align == "") align = " ⚠️";
      bestTag = " | 📦 HIST [" + rangeStr + "]" + align;
     }
   return bestTag;
  }

void GvSave()
  {
   // B++ pullback state
   GlobalVariableSet(GVK("PBD"),  (double)g_lastPullbackDir);
   GlobalVariableSet(GVK("PBTM"), (double)(long)g_lastPullbackTime);
   GlobalVariableSet(GVK("PBB"),  (double)g_lastPullbackBar);
   GlobalVariableSet(GVK("PBSD"), (double)g_lastPullbackSlowDir);

   // RS trend + RBS/SBR gate
   GlobalVariableSet(GVK("RST"),  (double)g_curRSTrend);
   GlobalVariableSet(GVK("RBSD"), (double)g_lastRBSSBRDir);
   GlobalVariableSet(GVK("RBST"), (double)(long)g_lastRBSSBRTime);

   // LTF bar dedup
   GlobalVariableSet(GVK("LTFT"), (double)(long)g_lastLTFBarTime);

   // Ranging state + box
   GlobalVariableSet(GVK("RNG"),  g_isRanging  ? 1.0 : 0.0);
   GlobalVariableSet(GVK("RPH"),  g_rangePH);
   GlobalVariableSet(GVK("RPL"),  g_rangePL);
   GlobalVariableSet(GVK("RNGN"), g_rangingNotified ? 1.0 : 0.0);
   GlobalVariableSet(GVK("RNGT"), (double)(long)g_rangingLastReminder);
   GlobalVariableSet(GVK("RNGB"), (double)(long)g_rangingBreakTime);
   GlobalVariableSet(GVK("RTACT"), g_rangeTradeActive ? 1.0 : 0.0);
   GlobalVariableSet(GVK("RTBT"),  (double)g_rangeBuyTouches);
   GlobalVariableSet(GVK("RTST"),  (double)g_rangeSellTouches);
   GlobalVariableSet(GVK("FRBUP"), g_fibRangeBreakUp   ? 1.0 : 0.0);
   GlobalVariableSet(GVK("FRBDN"), g_fibRangeBreakDown ? 1.0 : 0.0);
   // Consolidation history
   for(int h = 0; h < HIST_MAX; h++)
     {
      string p = "H" + IntegerToString(h);
      GlobalVariableSet(GVK(p+"H"), g_hist[h].high);
      GlobalVariableSet(GVK(p+"L"), g_hist[h].low);
      GlobalVariableSet(GVK(p+"T"), (double)(long)g_hist[h].confirmTime);
      GlobalVariableSet(GVK(p+"D"), (double)g_hist[h].breakDir);
      GlobalVariableSet(GVK(p+"S"), (double)g_hist[h].touches);
      GlobalVariableSet(GVK(p+"V"), g_hist[h].valid ? 1.0 : 0.0);
     }
   GlobalVariableSet(GVK("PO3S"), (double)(int)g_po3State);
   GlobalVariableSet(GVK("PO3D"), (double)g_po3BreakDir);
   GlobalVariableSet(GVK("PO3H"), g_po3BreakHigh);
   GlobalVariableSet(GVK("PO3L"), g_po3BreakLow);
   GlobalVariableSet(GVK("PO3C"), (double)g_po3BarCount);
   GlobalVariableSet(GVK("PO3N"), g_po3Notified  ? 1.0 : 0.0);
   GlobalVariableSet(GVK("PO3R"), g_po3InRetest  ? 1.0 : 0.0);
   GlobalVariableSet(GVK("PO3BD"), (double)g_po3RangeBreakDir);
   GlobalVariableSet(GVK("PO3BB"), (double)g_po3RangeBreakBars);

   // Sniper state
   GlobalVariableSet(GVK("SNS"),  (double)(int)g_sniperState);
   GlobalVariableSet(GVK("SND"),  (double)g_sniperDir);
   GlobalVariableSet(GVK("SNRS1"), g_sniperRSSlow);
   GlobalVariableSet(GVK("SNRS2"), g_sniperRSFast);
   GlobalVariableSet(GVK("SNCH"),  g_sniperConsHigh);
   GlobalVariableSet(GVK("SNCL"),  g_sniperConsLow);
   GlobalVariableSet(GVK("SNCT"),  (double)(long)g_sniperConsTime);
   GlobalVariableSet(GVK("LSD"),   (double)g_lastSignalDir);
   GlobalVariableSet(GVK("LSB"),   (double)g_lastSignalBar);
   GlobalVariableSet(GVK("LRSD"),  (double)g_lastRSDir);
  }

bool GvRestore()
  {
   // Require sentinel key — confirms a prior save for this symbol
   if(!GlobalVariableCheck(GVK("PBD"))) return false;

   g_lastPullbackDir    = (int)GlobalVariableGet(GVK("PBD"));
   g_lastPullbackTime      = (datetime)(long)GlobalVariableGet(GVK("PBTM"));
   g_lastPullbackBar       = (int)GlobalVariableGet(GVK("PBB"));
   g_lastPullbackSlowDir   = GlobalVariableCheck(GVK("PBSD")) ? (int)GlobalVariableGet(GVK("PBSD")) : 0;

   g_curRSTrend         = (int)GlobalVariableGet(GVK("RST"));
   g_lastRBSSBRDir      = (int)GlobalVariableGet(GVK("RBSD"));
   g_lastRBSSBRTime     = GlobalVariableCheck(GVK("RBST")) ? (datetime)(long)GlobalVariableGet(GVK("RBST")) : 0;

   g_lastLTFBarTime     = (datetime)(long)GlobalVariableGet(GVK("LTFT"));

   g_isRanging          = (GlobalVariableGet(GVK("RNG")) > 0.5);
   g_rangePH            = GlobalVariableGet(GVK("RPH"));
   g_rangePL            = GlobalVariableGet(GVK("RPL"));
   g_rangingNotified      = GlobalVariableCheck(GVK("RNGN")) ? (GlobalVariableGet(GVK("RNGN")) > 0.5) : false;
   g_rangingLastReminder  = GlobalVariableCheck(GVK("RNGT")) ? (datetime)(long)GlobalVariableGet(GVK("RNGT")) : 0;
   g_rangingBreakTime     = GlobalVariableCheck(GVK("RNGB")) ? (datetime)(long)GlobalVariableGet(GVK("RNGB")) : 0;
   g_rangeTradeActive   = GlobalVariableCheck(GVK("RTACT")) ? (GlobalVariableGet(GVK("RTACT")) > 0.5) : false;
   g_rangeBuyTouches    = GlobalVariableCheck(GVK("RTBT"))  ? (int)GlobalVariableGet(GVK("RTBT"))  : 0;
   g_rangeSellTouches   = GlobalVariableCheck(GVK("RTST"))  ? (int)GlobalVariableGet(GVK("RTST"))  : 0;
   g_fibRangeBreakUp    = GlobalVariableCheck(GVK("FRBUP")) ? (GlobalVariableGet(GVK("FRBUP")) > 0.5) : false;
   g_fibRangeBreakDown  = GlobalVariableCheck(GVK("FRBDN")) ? (GlobalVariableGet(GVK("FRBDN")) > 0.5) : false;
   if(g_fibRangeBreakUp) g_fibRangeBreakDown = false;  // mutual exclusivity guard
   // Consolidation history restore
   g_histCount = 0;
   for(int h = 0; h < HIST_MAX; h++)
     {
      string p = "H" + IntegerToString(h);
      g_hist[h].valid = GlobalVariableCheck(GVK(p+"V")) ? (GlobalVariableGet(GVK(p+"V")) > 0.5) : false;
      if(g_hist[h].valid)
        {
         g_hist[h].high        = GlobalVariableCheck(GVK(p+"H")) ? GlobalVariableGet(GVK(p+"H")) : 0;
         g_hist[h].low         = GlobalVariableCheck(GVK(p+"L")) ? GlobalVariableGet(GVK(p+"L")) : 0;
         g_hist[h].confirmTime = GlobalVariableCheck(GVK(p+"T")) ? (datetime)(long)GlobalVariableGet(GVK(p+"T")) : 0;
         g_hist[h].breakDir    = GlobalVariableCheck(GVK(p+"D")) ? (int)GlobalVariableGet(GVK(p+"D")) : 0;
         g_hist[h].touches     = GlobalVariableCheck(GVK(p+"S")) ? (int)GlobalVariableGet(GVK(p+"S")) : 0;
         g_histCount++;
        }
     }
   g_po3State    = GlobalVariableCheck(GVK("PO3S")) ? (EPO3State)(int)GlobalVariableGet(GVK("PO3S")) : PO3_NONE;
   g_po3BreakDir = GlobalVariableCheck(GVK("PO3D")) ? (int)GlobalVariableGet(GVK("PO3D")) : 0;
   g_po3BreakHigh= GlobalVariableCheck(GVK("PO3H")) ? GlobalVariableGet(GVK("PO3H")) : 0.0;
   g_po3BreakLow = GlobalVariableCheck(GVK("PO3L")) ? GlobalVariableGet(GVK("PO3L")) : 0.0;
   g_po3BarCount = GlobalVariableCheck(GVK("PO3C")) ? (int)GlobalVariableGet(GVK("PO3C")) : 0;
   g_po3Notified = GlobalVariableCheck(GVK("PO3N")) ? (GlobalVariableGet(GVK("PO3N")) > 0.5) : false;
   g_po3InRetest     = GlobalVariableCheck(GVK("PO3R"))  ? (GlobalVariableGet(GVK("PO3R"))  > 0.5) : false;
   g_po3RangeBreakDir  = GlobalVariableCheck(GVK("PO3BD")) ? (int)GlobalVariableGet(GVK("PO3BD")) : 0;
   g_po3RangeBreakBars = GlobalVariableCheck(GVK("PO3BB")) ? (int)GlobalVariableGet(GVK("PO3BB")) : 0;

   // Sniper state
   g_sniperState    = (ESniperState)(int)GlobalVariableGet(GVK("SNS"));
   g_sniperDir      = (int)GlobalVariableGet(GVK("SND"));
   g_sniperRSSlow   = GlobalVariableGet(GVK("SNRS1"));
   g_sniperRSFast   = GlobalVariableGet(GVK("SNRS2"));
   g_sniperConsHigh = GlobalVariableGet(GVK("SNCH"));
   g_sniperConsLow  = GlobalVariableGet(GVK("SNCL"));
   g_sniperConsTime = (datetime)(long)GlobalVariableGet(GVK("SNCT"));
   g_lastSignalDir  = GlobalVariableCheck(GVK("LSD"))  ? (int)GlobalVariableGet(GVK("LSD"))  : 0;
   g_lastSignalBar  = GlobalVariableCheck(GVK("LSB"))  ? (int)GlobalVariableGet(GVK("LSB"))  : -1;
   g_lastRSDir      = GlobalVariableCheck(GVK("LRSD")) ? (int)GlobalVariableGet(GVK("LRSD")) : 0;

   return true;
  }

