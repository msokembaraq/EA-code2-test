}

void FireEngine1Signal(int dir, double price, double sl,
                       double tp1, double tp2, double tp3,
                       bool alsoSBR, int barIndex)
{
   if(!InpPushEngine1) return;
   if(dir == 1  && g_lastE1BuyBar  == barIndex) return;
   if(dir == -1 && g_lastE1SellBar == barIndex) return;
   if(dir ==  1) g_lastE1BuyBar  = barIndex;
   if(dir == -1) g_lastE1SellBar = barIndex;

   if(InpWriteGV)
   {
      GlobalVariableSet(_Symbol+"_TF_E1_DIR",   (double)dir);
      GlobalVariableSet(_Symbol+"_TF_E1_PRICE", price);
      GlobalVariableSet(_Symbol+"_TF_E1_TIME",  (double)TimeCurrent());
   }

   string bonus = alsoSBR ? " ⚡BONUS:SBR/RBS AGREES" : "";
   string emoji = (dir == 1) ? "🟢" : "🔴";
   string d     = (dir == 1) ? "BUY" : "SELL";
   string msg = emoji + " TRIO " + d + " [3-ENGINE]" + bonus +
                " | " + _Symbol + " " + EnumToString(InpSignalTF) +
                " | @" + DoubleToString(price, _Digits) +
                " | SL:"  + PriceStr(sl)  +
                " | TP1:" + PriceStr(tp1) +
                " | TP2:" + PriceStr(tp2) +
                " | TP3:" + PriceStr(tp3);
   FirePush(msg);
   Print(msg);
