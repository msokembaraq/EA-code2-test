      string tag = isFVG ? (isBull ? "FVG-B" : "FVG-S") : (isBull ? "OB-B" : "OB-S");
      ObjectSetString (0, name, OBJPROP_TEXT, tag);
   }
   else
   { ObjectSetInteger(0, name, OBJPROP_TIME, 1, t2); }
}

