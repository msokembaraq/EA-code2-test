   PlotIndexSetInteger(7, PLOT_ARROW_SHIFT, -14);  // E2 SELL above

   for(int p = 0; p < 8; p++)
      PlotIndexSetDouble(p, PLOT_EMPTY_VALUE, 0.0);

   // Create ATR handles on signal TF
   g_atrHandle    = iATR(_Symbol, InpSignalTF, InpRSATRLen);
